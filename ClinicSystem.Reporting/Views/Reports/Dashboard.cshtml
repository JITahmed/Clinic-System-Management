@model List<ClinicSystem.Reporting.DTOs.StatusCount>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var total = Model?.Sum(s => s.Count) ?? 0;
    var completed = Model?.FirstOrDefault(s => s.Status == "Completed")?.Count ?? 0;
    var cancelled = Model?.FirstOrDefault(s => s.Status == "Cancelled")?.Count ?? 0;
    var missed = Model?.FirstOrDefault(s => s.Status == "Missed")?.Count ?? 0;
    var pending = Model?.FirstOrDefault(s => s.Status == "Requested")?.Count ?? 0;
}

<div class="r-topbar">
    <div>
        <h1>Dashboard</h1>
        <p>Overview of all appointment statistics across the clinic.</p>
    </div>
    <span class="stat-pill stat-pill-green"><i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> Live Data</span>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="r-card">
            <div class="r-card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:#1a7a4a;">@total</div>
                <div style="font-size:0.8rem;color:#888;font-weight:500;">Total Appointments</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="r-card">
            <div class="r-card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:#0d6efd;">@completed</div>
                <div style="font-size:0.8rem;color:#888;font-weight:500;">Completed</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="r-card">
            <div class="r-card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:#dc3545;">@cancelled</div>
                <div style="font-size:0.8rem;color:#888;font-weight:500;">Cancelled</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="r-card">
            <div class="r-card-body text-center py-3">
                <div style="font-size:2rem;font-weight:800;color:#f59e0b;">@pending</div>
                <div style="font-size:0.8rem;color:#888;font-weight:500;">Pending</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Chart -->
    <div class="col-md-7">
        <div class="r-card">
            <div class="r-card-header">
                <h5>Appointments by Status</h5>
            </div>
            <div class="r-card-body">
                <canvas id="statusChart" height="280"></canvas>
            </div>
        </div>
    </div>

    <!-- Status Breakdown Table -->
    <div class="col-md-5">
        <div class="r-card">
            <div class="r-card-header">
                <h5>Status Breakdown</h5>
            </div>
            <div class="r-card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center text-muted py-4">No data available.</div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Status</th>
                                <th class="text-center">Count</th>
                                <th class="pe-3">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                var pct = total > 0 ? (s.Count * 100.0 / total) : 0;
                                <tr>
                                    <td class="ps-3">@s.Status</td>
                                    <td class="text-center"><strong>@s.Count</strong></td>
                                    <td class="pe-3" style="min-width:120px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1">
                                                <div class="progress-bar" style="width:@pct.ToString("F0")%"></div>
                                            </div>
                                            <small style="font-size:0.75rem;color:#888;white-space:nowrap;">@pct.ToString("F0")%</small>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const labels = [@Html.Raw(string.Join(",", (Model ?? new()).Select(s => $"'{s.Status}'")))];
    const data = [@Html.Raw(string.Join(",", (Model ?? new()).Select(s => s.Count)))];
    const colors = ['#ffc107','#0dcaf0','#0d6efd','#198754','#1a7a4a','#dc3545','#6c757d'];

    new Chart(document.getElementById('statusChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Appointments',
                data,
                backgroundColor: colors.slice(0, labels.length),
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f0f3f6' }, ticks: { precision: 0 } },
                x: { grid: { display: false } }
            }
        }
    });
</script>
}
