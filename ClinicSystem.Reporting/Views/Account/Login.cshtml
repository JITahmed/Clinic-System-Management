@{
    ViewData["Title"] = "Clinic Manager Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reporting Portal — Login</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --brand-green: #1a7a4a;
            --brand-green-dark: #155f39;
        }
        body {
            background: linear-gradient(135deg, #0d2018 0%, #1a3a28 50%, #0d2018 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
        }
        .login-card {
            background: #fff;
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }
        .login-logo {
            width: 48px;
            height: 48px;
            background: var(--brand-green);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.4rem;
            margin-bottom: 1.5rem;
        }
        .login-card h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 0.25rem;
        }
        .login-card .subtitle {
            color: #888;
            font-size: 0.9rem;
            margin-bottom: 1.75rem;
        }
        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
            color: #444;
            margin-bottom: 0.4rem;
        }
        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e0e0e0;
            padding: 0.65rem 1rem;
            font-size: 0.95rem;
            transition: border-color 0.2s;
        }
        .form-control:focus {
            border-color: var(--brand-green);
            box-shadow: 0 0 0 3px rgba(26,122,74,0.12);
        }
        .btn-login {
            background: var(--brand-green);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.75rem;
            font-weight: 600;
            font-size: 0.95rem;
            width: 100%;
            transition: background 0.2s;
        }
        .btn-login:hover {
            background: var(--brand-green-dark);
            color: white;
        }
        .portal-badge {
            background: rgba(26,122,74,0.08);
            color: var(--brand-green);
            border-radius: 20px;
            padding: 0.25rem 0.75rem;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <i class="bi bi-clipboard2-pulse-fill"></i>
        </div>
        <span class="portal-badge">Reporting Portal</span>
        <h2>Welcome back</h2>
        <p class="subtitle">Sign in with your Clinic Manager credentials to access reports.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger rounded-3 py-2 mb-3" style="font-size:0.875rem;">
                <i class="bi bi-exclamation-circle me-1"></i> @ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login">
            <div class="mb-3">
                <label class="form-label">Email address</label>
                <input type="email" name="email" class="form-control" placeholder="manager@clinic.com" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign in to Reporting
            </button>
        </form>

        <p class="text-center text-muted mt-4 mb-0" style="font-size:0.8rem;">
            This portal is restricted to Clinic Managers only.
        </p>
    </div>
</body>
</html>
