<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Clinic Reporting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            --brand-green: #1a7a4a;
            --brand-green-dark: #155f39;
            --sidebar-bg: #0d2018;
            --sidebar-text: rgba(255,255,255,0.75);
            --sidebar-active: rgba(26,122,74,0.25);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f4f6f9;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .r-sidebar {
            width: 240px;
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
        }

        .r-sidebar-brand {
            padding: 1.5rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

            .r-sidebar-brand .brand-icon {
                width: 36px;
                height: 36px;
                background: var(--brand-green);
                border-radius: 8px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 1rem;
                margin-bottom: 0.5rem;
            }

            .r-sidebar-brand h6 {
                color: white;
                font-weight: 700;
                font-size: 0.95rem;
                margin: 0;
            }

            .r-sidebar-brand small {
                color: rgba(255,255,255,0.45);
                font-size: 0.72rem;
            }

        .r-nav {
            padding: 1rem 0.75rem;
            flex: 1;
        }

        .r-nav-label {
            color: rgba(255,255,255,0.3);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0 0.5rem;
            margin-bottom: 0.5rem;
        }

        .r-nav a {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.55rem 0.75rem;
            border-radius: 8px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 2px;
            transition: all 0.15s;
        }

            .r-nav a:hover, .r-nav a.active {
                background: var(--sidebar-active);
                color: #4ade80;
            }

            .r-nav a i {
                font-size: 1rem;
                width: 18px;
            }

        .r-sidebar-footer {
            padding: 1rem 0.75rem;
            border-top: 1px solid rgba(255,255,255,0.07);
        }

        .r-user-info {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            margin-bottom: 0.75rem;
        }

        .r-user-avatar {
            width: 32px;
            height: 32px;
            background: var(--brand-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .r-user-info small {
            color: rgba(255,255,255,0.5);
            font-size: 0.72rem;
            display: block;
        }

        .r-user-info span {
            color: white;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.5rem 0.75rem;
            background: rgba(220,53,69,0.12);
            color: #f87171;
            border: none;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 500;
            text-decoration: none;
            transition: background 0.15s;
        }

            .btn-logout:hover {
                background: rgba(220,53,69,0.22);
                color: #f87171;
            }

        /* Main content */
        .r-main {
            margin-left: 240px;
            flex: 1;
            padding: 2rem;
        }

        .r-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.75rem;
        }

            .r-topbar h1 {
                font-size: 1.4rem;
                font-weight: 700;
                color: #111;
                margin: 0;
            }

            .r-topbar p {
                color: #888;
                font-size: 0.875rem;
                margin: 0.2rem 0 0;
            }

        .r-card {
            background: white;
            border-radius: 12px;
            border: 1px solid #e8ecf0;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .r-card-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #f0f3f6;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .r-card-header h5 {
                margin: 0;
                font-size: 0.95rem;
                font-weight: 600;
                color: #222;
            }

        .r-card-body {
            padding: 1.25rem;
        }

        .stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.85rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .stat-pill-green {
            background: rgba(26,122,74,0.1);
            color: var(--brand-green);
        }

        .stat-pill-red {
            background: rgba(220,53,69,0.1);
            color: #dc3545;
        }

        .stat-pill-blue {
            background: rgba(13,110,253,0.1);
            color: #0d6efd;
        }

        .table th {
            font-size: 0.8rem;
            font-weight: 600;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .table td {
            font-size: 0.875rem;
            color: #333;
            vertical-align: middle;
        }

        .progress {
            height: 6px;
            border-radius: 10px;
        }

        .progress-bar {
            background: var(--brand-green);
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <nav class="r-sidebar">
        <div class="r-sidebar-brand">
            <div class="brand-icon"><i class="bi bi-clipboard2-pulse-fill"></i></div>
            <h6>Clinic Reporting</h6>
            <small>Management Portal</small>
        </div>
        <div class="r-nav">
            <div class="r-nav-label">Reports</div>
            <a asp-controller="Reports" asp-action="Dashboard"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>
            <a asp-controller="Reports" asp-action="DoctorUtilization"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "DoctorUtilization" ? "active" : "")">
                <i class="bi bi-person-badge-fill"></i> Doctor Utilization
            </a>
            <a asp-controller="Reports" asp-action="CancellationRates"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "CancellationRates" ? "active" : "")">
                <i class="bi bi-x-circle-fill"></i> Cancellation Rates
            </a>
        </div>
        <div class="r-sidebar-footer">
            <div class="r-user-info">
                <div class="r-user-avatar">CM</div>
                <div>
                    <span>Clinic Manager</span>
                    <small>@Context.Session.GetString("userEmail")</small>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="btn-logout">
                <i class="bi bi-box-arrow-left"></i> Sign Out
            </a>
        </div>
    </nav>

    <main class="r-main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
