<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicSystem.web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicSystem.web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/patient-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    ClinicSystem.web
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link text-white patient-nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                Home
                            </a>
                        </li>
                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white patient-nav-link" asp-controller="Doctor" asp-action="Dashboard">
                                    <i class="bi bi-grid-fill"></i>
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white patient-nav-link" asp-controller="Doctor" asp-action="UpcomingAppointments">
                                    <i class="bi bi-calendar-check-fill"></i>
                                    Appointments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white patient-nav-link" asp-controller="Doctor" asp-action="MySchedule">
                                    <i class="bi bi-calendar3"></i>
                                    My Schedule
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("ClinicManager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="ClinicManager" asp-action="Dashboard">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="ClinicManager" asp-action="DoctorList">Doctors</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="ClinicManager" asp-action="SpecializationList">Specializations</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="ClinicManager" asp-action="UserList">Users</a>
                            </li>
                        }

                        @if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white patient-nav-link" asp-controller="Patient" asp-action="Dashboard">
                                    <i class="bi bi-grid-fill"></i>
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white patient-nav-link" asp-controller="Patient" asp-action="BrowseDoctors">
                                    <i class="bi bi-person-vcard-fill"></i>
                                    Find Doctor
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white patient-nav-link" asp-controller="Patient" asp-action="BookAppointment">
                                    <i class="bi bi-calendar-plus-fill"></i>
                                    Book Appointment
                                </a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-white patient-nav-link" asp-controller="Notification" asp-action="Index">
                                    <i class="bi bi-bell-fill"></i>
                                    Notifications
                                </a>
                            </li>
                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ClinicSystem.web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>