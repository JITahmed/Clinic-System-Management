@using Microsoft.AspNetCore.Identity
@using ClinicSystem.Api.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GoodWill Clinic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    @{
        bool isAuthenticated = SignInManager.IsSignedIn(User);
        bool isManager = User.IsInRole("ClinicManager");
        bool isDoctor = User.IsInRole("Doctor");
        bool isPatient = User.IsInRole("Patient");
        bool isReceptionist = User.IsInRole("Receptionist");

        string currentUser = isAuthenticated ? (UserManager.GetUserName(User) ?? "") : "";
        string initials = currentUser.Length > 0 ? currentUser[..1].ToUpper() : "?";

        string roleName = isManager ? "Clinic Manager" : isDoctor ? "Doctor" : isPatient ? "Patient" : isReceptionist ? "Receptionist" : "";
        string roleClass = isManager ? "role-manager" : isDoctor ? "role-doctor" : isPatient ? "role-patient" : isReceptionist ? "role-receptionist" : "";
    }

    @if (!isAuthenticated)
    {
        <div class="gw-public">
            <nav class="gw-home-topbar">
                <a class="gw-home-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                    Goodwill<span>Clinic</span>
                </a>
                <div class="gw-home-nav">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn-gw-secondary btn-gw-sm">Sign In</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn-gw-primary btn-gw-sm">Register</a>
                </div>
            </nav>
            <main>@RenderBody()</main>
            <footer class="gw-footer">
                <p>&copy; @DateTime.Now.Year GoodWill Clinic. All rights reserved. &nbsp;|&nbsp; <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></p>
            </footer>
        </div>
    }
    else
    {
        <div class="gw-shell">
            <div class="gw-sidebar-overlay" id="sidebarOverlay"></div>

            <aside class="gw-sidebar" id="sidebar">
                <!-- Brand — clicking takes back to homepage -->
                <a class="gw-sidebar-brand" asp-controller="Home" asp-action="Index" style="text-decoration:none;">
                    <div class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                    <span class="brand-name">Goodwill<span>Clinic</span></span>
                </a>

                <div class="gw-sidebar-section" style="flex:1;overflow-y:auto;">

                    @if (isManager)
                    {
                        <div class="gw-sidebar-section-label">Navigation</div>
                        <a class="gw-nav-item" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-fill nav-icon"></i> Home
                        </a>

                        <div class="gw-sidebar-section-label" style="margin-top:12px;">Management</div>
                        <a class="gw-nav-item" asp-controller="ClinicManager" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill nav-icon"></i> Dashboard
                        </a>

                        <button class="gw-nav-item" type="button" data-bs-toggle="collapse" data-bs-target="#menuDoctors" aria-expanded="false">
                            <i class="bi bi-person-badge-fill nav-icon"></i> Doctors
                            <i class="bi bi-chevron-right nav-arrow"></i>
                        </button>
                        <div class="collapse gw-nav-submenu" id="menuDoctors">
                            <a class="gw-nav-item" asp-controller="ClinicManager" asp-action="DoctorList">
                                <i class="bi bi-list-ul nav-icon"></i> All Doctors
                            </a>
                            <a class="gw-nav-item" asp-controller="ClinicManager" asp-action="CreateDoctor">
                                <i class="bi bi-plus-circle nav-icon"></i> Add Doctor
                            </a>
                        </div>

                        <button class="gw-nav-item" type="button" data-bs-toggle="collapse" data-bs-target="#menuSpec" aria-expanded="false">
                            <i class="bi bi-clipboard2-pulse-fill nav-icon"></i> Specializations
                            <i class="bi bi-chevron-right nav-arrow"></i>
                        </button>
                        <div class="collapse gw-nav-submenu" id="menuSpec">
                            <a class="gw-nav-item" asp-controller="ClinicManager" asp-action="SpecializationList">
                                <i class="bi bi-list-ul nav-icon"></i> All Specializations
                            </a>
                            <a class="gw-nav-item" asp-controller="ClinicManager" asp-action="CreateSpecialization">
                                <i class="bi bi-plus-circle nav-icon"></i> Add Specialization
                            </a>
                        </div>

                        <a class="gw-nav-item" asp-controller="ClinicManager" asp-action="UserList">
                            <i class="bi bi-people-fill nav-icon"></i> Users
                        </a>
                    }

                    @if (isDoctor)
                    {
                        <div class="gw-sidebar-section-label">Navigation</div>
                        <a class="gw-nav-item" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-fill nav-icon"></i> Home
                        </a>
                        <div class="gw-sidebar-section-label" style="margin-top:12px;">Doctor Portal</div>
                        <a class="gw-nav-item" asp-controller="Doctor" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill nav-icon"></i> Dashboard
                        </a>
                        <button class="gw-nav-item" type="button" data-bs-toggle="collapse" data-bs-target="#menuAppts" aria-expanded="false">
                            <i class="bi bi-calendar2-week-fill nav-icon"></i> Appointments
                            <i class="bi bi-chevron-right nav-arrow"></i>
                        </button>
                        <div class="collapse gw-nav-submenu" id="menuAppts">
                            <a class="gw-nav-item" asp-controller="Doctor" asp-action="Dashboard">
                                <i class="bi bi-clock nav-icon"></i> Today
                            </a>
                            <a class="gw-nav-item" asp-controller="Doctor" asp-action="UpcomingAppointments">
                                <i class="bi bi-calendar-check nav-icon"></i> Upcoming
                            </a>
                        </div>
                        <a class="gw-nav-item" asp-controller="Doctor" asp-action="MySchedule">
                            <i class="bi bi-calendar3 nav-icon"></i> My Schedule
                        </a>
                        <a class="gw-nav-item" asp-controller="Doctor" asp-action="Notifications">
                            <i class="bi bi-bell-fill nav-icon"></i> Notifications
                        </a>
                    }

                    @if (isPatient)
                    {
                        <div class="gw-sidebar-section-label">Navigation</div>
                        <a class="gw-nav-item" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-fill nav-icon"></i> Home
                        </a>
                        <div class="gw-sidebar-section-label" style="margin-top:12px;">Patient Portal</div>
                        <a class="gw-nav-item" asp-controller="Patient" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill nav-icon"></i> Dashboard
                        </a>
                        <button class="gw-nav-item" type="button" data-bs-toggle="collapse" data-bs-target="#menuPatAppts" aria-expanded="false">
                            <i class="bi bi-calendar2-week-fill nav-icon"></i> Appointments
                            <i class="bi bi-chevron-right nav-arrow"></i>
                        </button>
                        <div class="collapse gw-nav-submenu" id="menuPatAppts">
                            <a class="gw-nav-item" asp-controller="Patient" asp-action="BookAppointment">
                                <i class="bi bi-plus-circle nav-icon"></i> Book Appointment
                            </a>
                            <a class="gw-nav-item" asp-controller="Patient" asp-action="Upcoming">
                                <i class="bi bi-calendar-check nav-icon"></i> Upcoming
                            </a>
                            <a class="gw-nav-item" asp-controller="Patient" asp-action="History">
                                <i class="bi bi-clock-history nav-icon"></i> History
                            </a>
                        </div>
                        <a class="gw-nav-item" asp-controller="Patient" asp-action="BrowseDoctors">
                            <i class="bi bi-person-vcard-fill nav-icon"></i> Find a Doctor
                        </a>
                        <a class="gw-nav-item" asp-controller="Patient" asp-action="Profile">
                            <i class="bi bi-person-circle nav-icon"></i> My Profile
                        </a>
                        <a class="gw-nav-item" asp-controller="Patient" asp-action="Notifications">
                            <i class="bi bi-bell-fill nav-icon"></i> Notifications
                        </a>
                    }

                    @if (isReceptionist)
                    {
                        <div class="gw-sidebar-section-label">Navigation</div>
                        <a class="gw-nav-item" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-fill nav-icon"></i> Home
                        </a>
                        <div class="gw-sidebar-section-label" style="margin-top:12px;">Receptionist</div>
                        <a class="gw-nav-item" asp-controller="Receptionist" asp-action="Dashboard">
                            <i class="bi bi-grid-1x2-fill nav-icon"></i> Dashboard
                        </a>
                        <button class="gw-nav-item" type="button" data-bs-toggle="collapse" data-bs-target="#menuRecAppts" aria-expanded="false">
                            <i class="bi bi-calendar2-week-fill nav-icon"></i> Appointments
                            <i class="bi bi-chevron-right nav-arrow"></i>
                        </button>
                        <div class="collapse gw-nav-submenu" id="menuRecAppts">
                            <a class="gw-nav-item" asp-controller="Receptionist" asp-action="AppointmentList">
                                <i class="bi bi-list-ul nav-icon"></i> All Appointments
                            </a>
                            <a class="gw-nav-item" asp-controller="Receptionist" asp-action="BookAppointment">
                                <i class="bi bi-plus-circle nav-icon"></i> Book Appointment
                            </a>
                        </div>
                        <a class="gw-nav-item" asp-controller="Receptionist" asp-action="PatientSearch">
                            <i class="bi bi-search nav-icon"></i> Patient Search
                        </a>
                        <a class="gw-nav-item" asp-controller="Receptionist" asp-action="LiveBoard" target="_blank">
                            <i class="bi bi-display-fill nav-icon"></i> Live Board
                        </a>
                        <a class="gw-nav-item" asp-controller="Notification" asp-action="Index">
                            <i class="bi bi-bell-fill nav-icon"></i> Notifications
                        </a>
                    }
                </div>

                <div class="gw-sidebar-footer">
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="gw-nav-item" style="color:#f87171;">
                            <i class="bi bi-box-arrow-left nav-icon"></i> Sign Out
                        </button>
                    </form>
                </div>
            </aside>

            <header class="gw-topbar">
                <div class="gw-topbar-left">
                    <button class="gw-sidebar-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
                    <span class="gw-topbar-title">@(ViewData["Title"] ?? "GoodWill Clinic")</span>
                </div>
                <div class="gw-topbar-right">
                    @if (isPatient)
                    {
                        <a asp-controller="Patient" asp-action="Notifications" class="gw-topbar-btn">
                            <i class="bi bi-bell"></i>
                        </a>
                    }
                    else if (isDoctor)
                    {
                        <a asp-controller="Doctor" asp-action="Notifications" class="gw-topbar-btn">
                            <i class="bi bi-bell"></i>
                        </a>
                    }
                    else if (isReceptionist || isManager)
                    {
                        <a asp-controller="Notification" asp-action="Index" class="gw-topbar-btn">
                            <i class="bi bi-bell"></i>
                        </a>
                    }
                    <div class="gw-user-chip">
                        <div class="gw-user-avatar">@initials</div>
                        <span>@currentUser</span>
                        @if (roleName != "")
                        {
                            <span class="gw-role-badge @roleClass">@roleName</span>
                        }
                    </div>
                </div>
            </header>

            <main class="gw-main">
                @if (TempData["Success"] != null)
                {
                    <div class="gw-alert gw-alert-success mb-4"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="gw-alert gw-alert-danger mb-4"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="gw-alert gw-alert-success mb-4"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="gw-alert gw-alert-danger mb-4"><i class="bi bi-exclamation-circle-fill"></i> @TempData["ErrorMessage"]</div>
                }
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggle  = document.getElementById('sidebarToggle');
        if (toggle) {
            toggle.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('show'); });
            overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('show'); });
        }
        document.querySelectorAll('.gw-nav-submenu .gw-nav-item').forEach(link => {
            if (link.href && window.location.href.includes(new URL(link.href).pathname)) {
                link.classList.add('active');
                const col = link.closest('.collapse');
                if (col) { col.classList.add('show'); const btn = document.querySelector(`[data-bs-target="#${col.id}"]`); if(btn) btn.setAttribute('aria-expanded','true'); }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
