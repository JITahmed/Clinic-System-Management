@{
    ViewData["Title"] = "Patient Search";
}

<h2 class="mb-4">Patient Search</h2>

<form asp-action="PatientSearch" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <div class="input-group">
        <input type="text" name="query" class="form-control form-control-lg"
               value="@ViewBag.Query"
               placeholder="Search by name, CPR number, reference, or phone..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (ViewBag.Results != null)
{
    var results = (IEnumerable<ClinicSystem.Api.Models.Patient>)ViewBag.Results;
    if (!results.Any())
    {
        <div class="alert alert-warning">No patients found for "@ViewBag.Query"</div>
    }
    else
    {
        <p class="text-muted">@results.Count() result(s) found</p>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>CPR</th>
                        <th>Ref Number</th>
                        <th>Gender</th>
                        <th>Blood Type</th>
                        <th>Phone</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in results)
                    {
                        <tr>
                            <td>@p.User.FullName</td>
                            <td>@p.CPRNumber</td>
                            <td><code>@p.PatientReferenceNumber</code></td>
                            <td>@p.Gender</td>
                            <td>@p.BloodType</td>
                            <td>@p.User.PhoneNumber</td>
                            <td>
                                <a asp-action="BookAppointment" asp-route-patientId="@p.Id"
                                   class="btn btn-sm btn-success">Book Appointment</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
