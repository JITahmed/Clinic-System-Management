@model IEnumerable<ClinicSystem.Api.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="page-shell">
    <div class="page-header d-flex justify-content-between align-items-start">
        <div>
            <h2>All Appointments</h2>
            <p>Filter, search, and manage all clinic appointments.</p>
        </div>
        <a asp-action="BookAppointment" class="btn soft-btn btn-soft-primary">
            <i class="bi bi-plus-circle me-1"></i> New Appointment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 shadow-sm mb-4">@TempData["Success"]</div>
    }

    <!-- Filter Bar -->
    <div class="form-card mb-4">
        <form asp-action="AppointmentList" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <input type="date" name="date" class="form-control"
                       value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<ClinicSystem.Api.Models.AppointmentStatus>())
                    {
                        <option value="@s" selected="@(ViewBag.SelectedStatus?.ToString() == s.ToString())">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control"
                       placeholder="Patient name, CPR, or reference..."
                       value="@ViewBag.Search" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn soft-btn btn-soft-primary w-100">Filter</button>
                <a asp-action="AppointmentList" class="btn soft-btn btn-soft-secondary w-100">Clear</a>
            </div>
        </form>
    </div>

    <!-- Results -->
    <div class="section-card">
        <div class="section-card-header">
            <h5>Results</h5>
        </div>
        <div class="section-card-body">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <h5>No appointments found</h5>
                    <p>No appointments match the selected filter.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Reference</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model)
                            {
                                <tr>
                                    <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@appt.StartTime.ToString(@"hh\:mm")</td>
                                    <td><code>@appt.AppointmentReferenceNumber</code></td>
                                    <td>@appt.Patient.User.FullName</td>
                                    <td>Dr. @appt.Doctor.User.FullName</td>
                                    <td>@appt.ReasonForVisit</td>
                                    <td>
                                        @switch (appt.Status)
                                        {
                                            case ClinicSystem.Api.Models.AppointmentStatus.Requested:
                                                <span class="badge-soft-warning">Requested</span>
                                                break;
                                            case ClinicSystem.Api.Models.AppointmentStatus.Confirmed:
                                                <span class="badge-soft-info">Confirmed</span>
                                                break;
                                            case ClinicSystem.Api.Models.AppointmentStatus.CheckedIn:
                                                <span class="badge-soft-primary">Checked In</span>
                                                break;
                                            case ClinicSystem.Api.Models.AppointmentStatus.InProgress:
                                                <span class="badge-soft-success">In Progress</span>
                                                break;
                                            case ClinicSystem.Api.Models.AppointmentStatus.Completed:
                                                <span class="badge-soft-success">Completed</span>
                                                break;
                                            case ClinicSystem.Api.Models.AppointmentStatus.Cancelled:
                                                <span class="badge-soft-danger">Cancelled</span>
                                                break;
                                            case ClinicSystem.Api.Models.AppointmentStatus.Missed:
                                                <span class="badge-soft-danger">Missed</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="AppointmentDetails" asp-route-id="@appt.Id"
                                           class="btn soft-btn btn-soft-primary btn-sm btn-arrow">
                                            Manage <span>›</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
