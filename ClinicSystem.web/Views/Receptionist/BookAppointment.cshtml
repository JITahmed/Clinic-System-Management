@{
    ViewData["Title"] = "Book Appointment";
}

<div class="page-shell">
    <div class="page-header">
        <h2>Book Appointment</h2>
        <p>Select a patient, specialization, doctor, date, and time slot to schedule an appointment.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <div class="form-card">
        <form asp-action="BookAppointment" method="post" id="bookingForm">
            @Html.AntiForgeryToken()

            <div class="section-card mb-4">
                <div class="section-card-header">
                    <h5>Patient & Doctor</h5>
                </div>
                <div class="section-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Patient <span class="text-danger">*</span></label>
                            <select name="PatientId" id="patientSelect" class="form-select" required>
                                <option value="">Select Patient</option>
                                @foreach (var p in (IEnumerable<ClinicSystem.Api.Models.Patient>)ViewBag.Patients)
                                {
                                    <option value="@p.Id"
                                            selected="@(ViewBag.SelectedPatientId?.ToString() == p.Id.ToString() ? "selected" : null)">
                                        @p.User.FullName (CPR: @p.CPRNumber)
                                    </option>
                                }
                            </select>
                            <small class="text-muted">Search and select the patient by name.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Specialization <span class="text-danger">*</span></label>
                            <select id="specializationSelect" class="form-select" required>
                                <option value="">Select Specialization</option>
                                @foreach (var s in (IEnumerable<ClinicSystem.Api.Models.Specialization>)ViewBag.Specializations)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Doctor <span class="text-danger">*</span></label>
                            <select name="DoctorId" id="doctorSelect" class="form-select" required>
                                <option value="">Select Specialization First</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="section-card mb-4">
                <div class="section-card-header">
                    <h5>Date & Time</h5>
                </div>
                <div class="section-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Appointment Date <span class="text-danger">*</span></label>
                            <input type="date" id="appointmentDate" name="AppointmentDate" class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Time Slot <span class="text-danger">*</span></label>
                            <select name="StartTime" id="slotSelect" class="form-select" required>
                                <option value="">Pick doctor &amp; date first</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="section-card mb-4">
                <div class="section-card-header">
                    <h5>Reason for Visit</h5>
                </div>
                <div class="section-card-body">
                    <textarea name="ReasonForVisit" class="form-control" rows="3"
                              placeholder="Brief description of the reason for this appointment..." required></textarea>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn soft-btn btn-soft-success">
                    <i class="bi bi-calendar-plus me-1"></i> Book Appointment
                </button>
                <a asp-action="Dashboard" class="btn soft-btn btn-soft-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const specializationSelect = document.getElementById('specializationSelect');
        const doctorSelect = document.getElementById('doctorSelect');
        const dateInput = document.getElementById('appointmentDate');
        const slotSelect = document.getElementById('slotSelect');

        specializationSelect.addEventListener('change', async () => {
            const specId = specializationSelect.value;
            doctorSelect.innerHTML = '<option value="">Loading...</option>';
            slotSelect.innerHTML = '<option value="">Pick doctor & date</option>';

            if (!specId) {
                doctorSelect.innerHTML = '<option value="">Select Specialization First</option>';
                return;
            }

            const res = await fetch(`/Receptionist/GetDoctorsBySpecialization/${specId}`);
            const doctors = await res.json();

            doctorSelect.innerHTML = '<option value="">Select Doctor</option>';
            doctors.forEach(d => {
                const opt = document.createElement('option');
                opt.value = d.id;
                opt.textContent = `Dr. ${d.name}`;
                doctorSelect.appendChild(opt);
            });
        });

        async function loadSlots() {
            const doctorId = doctorSelect.value;
            const date = dateInput.value;
            slotSelect.innerHTML = '<option value="">Loading slots...</option>';

            if (!doctorId || !date) {
                slotSelect.innerHTML = '<option value="">Pick doctor & date first</option>';
                return;
            }

            const res = await fetch(`/Receptionist/GetAvailableSlots?doctorId=${doctorId}&date=${date}`);
            const slots = await res.json();

            if (slots.length === 0) {
                slotSelect.innerHTML = '<option value="">No available slots</option>';
                return;
            }

            slotSelect.innerHTML = '<option value="">Select a Slot</option>';
            slots.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.start;
                opt.textContent = s.display;
                slotSelect.appendChild(opt);
            });
        }

        doctorSelect.addEventListener('change', loadSlots);
        dateInput.addEventListener('change', loadSlots);
    </script>
}
