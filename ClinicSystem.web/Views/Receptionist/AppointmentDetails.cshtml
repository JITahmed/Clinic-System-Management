@using ClinicSystem.Api.Models
@model ClinicSystem.Api.Models.Appointment
@{
    ViewData["Title"] = "Appointment Details";
    var status = Model.Status;

    string StatusBadgeClass(AppointmentStatus s) => s switch
    {
        AppointmentStatus.Requested => "badge-soft-warning",
        AppointmentStatus.Confirmed => "badge-soft-info",
        AppointmentStatus.CheckedIn => "badge-soft-primary",
        AppointmentStatus.InProgress => "badge-soft-success",
        AppointmentStatus.Completed => "badge-soft-success",
        AppointmentStatus.Cancelled => "badge-soft-danger",
        AppointmentStatus.Missed => "badge-soft-danger",
        _ => "badge-soft-info"
    };
}

<div class="page-shell">
    <div class="page-header d-flex justify-content-between align-items-start">
        <div>
            <h2>Appointment Details</h2>
            <p>View appointment information and update the status.</p>
        </div>
        <a asp-action="AppointmentList" class="btn soft-btn btn-soft-secondary btn-back">
            <span>‹</span> Back to List
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 shadow-sm mb-4">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <div class="row g-4">
        <!-- Left: Appointment Info -->
        <div class="col-md-7">
            <div class="section-card mb-4">
                <div class="section-card-header d-flex justify-content-between align-items-center">
                    <h5>@Model.AppointmentReferenceNumber</h5>
                    <span class="@StatusBadgeClass(status)">@status</span>
                </div>
                <div class="section-card-body">
                    <table class="table table-bordered info-table">
                        <tr>
                            <th>Date</th>
                            <td>@Model.AppointmentDate.ToString("dddd, dd MMM yyyy")</td>
                        </tr>
                        <tr>
                            <th>Time</th>
                            <td>@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</td>
                        </tr>
                        <tr>
                            <th>Patient</th>
                            <td>
                                @Model.Patient.User.FullName
                                <small class="text-muted">(CPR: @Model.Patient.CPRNumber)</small>
                            </td>
                        </tr>
                        <tr>
                            <th>Doctor</th>
                            <td>Dr. @Model.Doctor.User.FullName</td>
                        </tr>
                        <tr>
                            <th>Reason</th>
                            <td>@Model.ReasonForVisit</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.CancellationReason))
                        {
                            <tr>
                                <th>Cancellation Reason</th>
                                <td class="text-danger">@Model.CancellationReason</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>

            @if (Model.VisitRecord != null)
            {
                <div class="section-card">
                    <div class="section-card-header">
                        <h5>Visit Record</h5>
                    </div>
                    <div class="section-card-body">
                        <p><strong>Diagnosis:</strong> <span class="text-muted">@Model.VisitRecord.Diagnosis</span></p>
                        <p><strong>Doctor Notes:</strong> <span class="text-muted">@Model.VisitRecord.DoctorNotes</span></p>
                        <p class="mb-0"><strong>Treatment Plan:</strong> <span class="text-muted">@Model.VisitRecord.TreatmentPlan</span></p>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Status Actions -->
        <div class="col-md-5">
            <div class="section-card">
                <div class="section-card-header">
                    <h5>Update Status</h5>
                </div>
                <div class="section-card-body d-grid gap-2">

                    @* Confirm *@
                    @if (status == AppointmentStatus.Requested)
                    {
                        <form asp-action="ConfirmAppointment" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn soft-btn btn-soft-success w-100">
                                <i class="bi bi-check-circle me-1"></i> Confirm Appointment
                            </button>
                        </form>
                    }

                    @* Check In *@
                    @if (status == AppointmentStatus.Confirmed)
                    {
                        <form asp-action="CheckIn" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn soft-btn btn-soft-info w-100">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Check In Patient
                            </button>
                        </form>
                    }

                    @* Mark Missed *@
                    @if (status == AppointmentStatus.Confirmed)
                    {
                        <form asp-action="MarkMissed" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Mark this appointment as missed?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn soft-btn btn-soft-warning w-100">
                                <i class="bi bi-x-circle me-1"></i> Mark as Missed
                            </button>
                        </form>
                    }

                    @* Cancel *@
                    @if (status != AppointmentStatus.Completed &&
                                        status != AppointmentStatus.Cancelled &&
                                        status != AppointmentStatus.Missed)
                    {
                        <form asp-action="CancelAppointment" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <label class="form-label">Cancellation Reason</label>
                                <input type="text" name="cancellationReason" class="form-control"
                                       placeholder="Enter reason for cancellation" required />
                            </div>
                            <button type="submit" class="btn soft-btn btn-soft-danger w-100"
                                    onclick="return confirm('Cancel this appointment?')">
                                <i class="bi bi-x-lg me-1"></i> Cancel Appointment
                            </button>
                        </form>
                    }

                    @if (status == AppointmentStatus.Completed ||
                                        status == AppointmentStatus.Cancelled ||
                                        status == AppointmentStatus.Missed)
                    {
                        <div class="empty-state py-3">
                            <p class="text-muted mb-0">No further actions available for this appointment.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
