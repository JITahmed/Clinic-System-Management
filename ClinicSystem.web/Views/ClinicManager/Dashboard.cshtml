@{
    ViewData["Title"] = "Clinic Manager Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Clinic Manager Dashboard</h2>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary h-100">
                <div class="card-body text-center">
                    <h1 class="display-4">@ViewBag.TotalDoctors</h1>
                    <p class="card-text fs-5">Total Doctors</p>
                    <a asp-action="DoctorList" class="btn btn-light btn-sm">Manage Doctors</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success h-100">
                <div class="card-body text-center">
                    <h1 class="display-4">@ViewBag.TotalPatients</h1>
                    <p class="card-text fs-5">Total Patients</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center">
                    <h1 class="display-4">@ViewBag.TodayAppointments</h1>
                    <p class="card-text fs-5">Today's Appointments</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-warning h-100">
                <div class="card-body text-center">
                    <h1 class="display-4">@ViewBag.PendingAppointments</h1>
                    <p class="card-text fs-5">Pending Appointments</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-secondary h-100">
                <div class="card-body text-center">
                    <h1 class="display-4">@ViewBag.TotalAppointments</h1>
                    <p class="card-text fs-5">Total Appointments</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h4>Quick Actions</h4>
            <div class="d-flex gap-3 flex-wrap">
                <a asp-action="DoctorList" class="btn btn-primary">Manage Doctors</a>
                <a asp-action="SpecializationList" class="btn btn-secondary">Manage Specializations</a>
                <a asp-action="UserList" class="btn btn-dark">Manage Users</a>
            </div>
        </div>
    </div>
</div>