@{
    ViewData["Title"] = "Dashboard";
}

<div class="gw-page-header">
    <h2>Clinic Manager Dashboard</h2>
    <p>Overview of clinic operations — doctors, patients, and appointments at a glance.</p>
</div>

<div class="gw-stat-grid">
    <div class="gw-stat">
        <div class="gw-stat-icon navy"><i class="bi bi-person-badge-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@ViewBag.TotalDoctors</div>
            <div class="gw-stat-label">Total Doctors</div>
        </div>
    </div>
    <div class="gw-stat">
        <div class="gw-stat-icon green"><i class="bi bi-people-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@ViewBag.TotalPatients</div>
            <div class="gw-stat-label">Total Patients</div>
        </div>
    </div>
    <div class="gw-stat">
        <div class="gw-stat-icon teal"><i class="bi bi-calendar-check-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@ViewBag.TodayAppointments</div>
            <div class="gw-stat-label">Today's Appointments</div>
        </div>
    </div>
    <div class="gw-stat">
        <div class="gw-stat-icon orange"><i class="bi bi-hourglass-split"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@ViewBag.PendingAppointments</div>
            <div class="gw-stat-label">Pending Appointments</div>
        </div>
    </div>
    <div class="gw-stat">
        <div class="gw-stat-icon purple"><i class="bi bi-bar-chart-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@ViewBag.TotalAppointments</div>
            <div class="gw-stat-label">Total Appointments</div>
        </div>
    </div>
</div>

<div class="gw-card">
    <div class="gw-card-header">
        <span class="gw-card-title">Quick Actions</span>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a asp-action="DoctorList" class="btn-gw-primary"><i class="bi bi-person-badge-fill"></i> Manage Doctors</a>
        <a asp-action="SpecializationList" class="btn-gw-secondary"><i class="bi bi-clipboard2-pulse-fill"></i> Manage Specializations</a>
        <a asp-action="UserList" class="btn-gw-secondary"><i class="bi bi-people-fill"></i> Manage Users</a>
    </div>
</div>
