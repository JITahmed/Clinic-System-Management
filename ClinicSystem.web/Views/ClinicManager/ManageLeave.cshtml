@model ClinicSystem.Api.Models.Doctor
@{
    ViewData["Title"] = "Manage Leave";
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Leave Management</h2>
        <p>Dr. @Model.User.FullName</p>
    </div>
    <a asp-action="DoctorDetails" asp-route-id="@Model.Id" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div style="display:grid;grid-template-columns:1fr 1.5fr;gap:20px;align-items:start;">
    <div class="gw-card">
        <div class="gw-card-header"><span class="gw-card-title">Add Leave Period</span></div>
        <form asp-action="AddLeave" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="DoctorId" value="@Model.Id" />
            <div class="gw-form-group">
                <label class="gw-label">Start Date</label>
                <input type="date" name="StartDate" class="gw-input" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">End Date</label>
                <input type="date" name="EndDate" class="gw-input" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">Reason</label>
                <input type="text" name="Reason" class="gw-input" placeholder="e.g. Annual leave" />
            </div>
            <button type="submit" class="btn-gw-primary" style="width:100%;"><i class="bi bi-plus-lg"></i> Add Leave</button>
        </form>
    </div>

    <div class="gw-card">
        <div class="gw-card-header"><span class="gw-card-title">Existing Leave Periods</span></div>
        @if (!Model.Leaves.Any())
        {
            <div class="gw-empty"><p>No leave periods recorded.</p></div>
        }
        else
        {
            <table class="gw-table">
                <thead><tr><th>From</th><th>To</th><th>Reason</th><th></th></tr></thead>
                <tbody>
                    @foreach (var leave in Model.Leaves.OrderByDescending(l => l.StartDate))
                    {
                        <tr>
                            <td>@leave.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@leave.EndDate.ToString("dd MMM yyyy")</td>
                            <td>@leave.Reason</td>
                            <td>
                                <form asp-action="DeleteLeave" method="post" onsubmit="return confirm('Remove this leave period?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="leaveId" value="@leave.Id" />
                                    <input type="hidden" name="doctorId" value="@Model.Id" />
                                    <button type="submit" class="btn-gw-danger btn-gw-sm"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
