@model IEnumerable<ClinicSystem.Api.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Management</h2>
        <a asp-action="Dashboard" class="btn btn-secondary">← Back to Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var roles = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();
                var role = roles.FirstOrDefault() ?? "No Role";
                var badgeColor = role switch
                {
                    "ClinicManager" => "bg-danger",
                    "Doctor" => "bg-primary",
                    "Receptionist" => "bg-warning text-dark",
                    "Patient" => "bg-success",
                    _ => "bg-secondary"
                };

                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge @badgeColor">@role</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditUserRole" asp-route-id="@user.Id"
                           class="btn btn-sm btn-warning">Change Role</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>