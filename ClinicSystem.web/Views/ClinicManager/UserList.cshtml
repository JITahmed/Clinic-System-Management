@model IEnumerable<ClinicSystem.Api.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="gw-page-header">
    <h2>User Management</h2>
    <p>View all registered users and manage their roles.</p>
</div>

<div class="gw-table-wrap">
    <table class="gw-table">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var roles = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();
                var role = roles.FirstOrDefault() ?? "No Role";
                var badgeClass = role switch
                {
                    "ClinicManager" => "role-manager",
                    "Doctor" => "role-doctor",
                    "Receptionist" => "role-receptionist",
                    "Patient" => "role-patient",
                    _ => ""
                };
                <tr>
                    <td><span class="fw-600">@user.FullName</span></td>
                    <td class="text-muted-gw">@user.Email</td>
                    <td><span class="gw-role-badge @badgeClass">@role</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="gw-badge badge-active">Active</span>
                        }
                        else
                        {
                            <span class="gw-badge badge-inactive">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditUserRole" asp-route-id="@user.Id" class="btn-gw-secondary btn-gw-sm"><i class="bi bi-shield-check"></i> Change Role</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
