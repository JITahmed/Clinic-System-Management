@model IEnumerable<ClinicSystem.Api.Models.Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Doctors</h2>
        <p>Manage all registered doctors and their profiles.</p>
    </div>
    <a asp-action="CreateDoctor" class="btn-gw-primary"><i class="bi bi-plus-lg"></i> Add Doctor</a>
</div>

@if (!Model.Any())
{
    <div class="gw-card">
        <div class="gw-empty">
            <div class="gw-empty-icon"><i class="bi bi-person-badge"></i></div>
            <p>No doctors found. Add one to get started.</p>
        </div>
    </div>
}
else
{
    <div class="gw-table-wrap">
        <table class="gw-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>License</th>
                    <th>Specializations</th>
                    <th>Fee (BD)</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td><span class="fw-600">@d.User.FullName</span></td>
                        <td class="text-muted-gw">@d.User.Email</td>
                        <td>@d.LicenseNumber</td>
                        <td>@string.Join(", ", d.DoctorSpecializations.Select(ds => ds.Specialization.Name))</td>
                        <td>@d.ConsultationFee</td>
                        <td>
                            @if (d.IsAvailable)
                            {
                                <span class="gw-badge badge-active">Available</span>
                            }
                            else
                            {
                                <span class="gw-badge badge-inactive">Unavailable</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                <a asp-action="DoctorDetails" asp-route-id="@d.Id" class="btn-gw-secondary btn-gw-sm"><i class="bi bi-eye"></i> View</a>
                                <a asp-action="EditDoctor" asp-route-id="@d.Id" class="btn-gw-secondary btn-gw-sm"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="DeleteDoctor" asp-route-id="@d.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this doctor?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-gw-danger btn-gw-sm"><i class="bi bi-trash"></i> Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
