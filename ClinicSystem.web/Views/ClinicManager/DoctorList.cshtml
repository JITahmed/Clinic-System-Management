@model IEnumerable<ClinicSystem.Api.Models.Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Doctors</h2>
        <a asp-action="CreateDoctor" class="btn btn-primary">+ Add Doctor</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">No doctors found. Add one to get started.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>License</th>
                    <th>Specializations</th>
                    <th>Fee</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.User.FullName</td>
                        <td>@d.User.Email</td>
                        <td>@d.LicenseNumber</td>
                        <td>
                            @string.Join(", ", d.DoctorSpecializations.Select(ds => ds.Specialization.Name))
                        </td>
                        <td>BD @d.ConsultationFee</td>
                        <td>
                            @if (d.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Unavailable</span>
                            }
                        </td>
                        <td>
                            <a asp-action="DoctorDetails" asp-route-id="@d.Id"
                               class="btn btn-sm btn-info">View</a>
                            <a asp-action="EditDoctor" asp-route-id="@d.Id"
                               class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="DeleteDoctor" asp-route-id="@d.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this doctor?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Dashboard" class="btn btn-secondary mt-3">← Back to Dashboard</a>
</div>