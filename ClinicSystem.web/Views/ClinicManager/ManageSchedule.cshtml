@model ClinicSystem.Api.Models.Doctor
@{
    ViewData["Title"] = "Manage Schedule";
    var days = Enum.GetValues<DayOfWeek>();
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Schedule</h2>
        <p>Dr. @Model.User.FullName — set working hours per day</p>
    </div>
    <a asp-action="DoctorDetails" asp-route-id="@Model.Id" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="gw-card">
    <form asp-action="SaveSchedule" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DoctorId" value="@Model.Id" />

        <table class="gw-table" style="margin-bottom:20px;">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Working?</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in days)
                {
                    var existing = Model.Schedules.FirstOrDefault(s => s.DayOfWeek == day);
                    var isWorking = existing != null && existing.IsActive;
                    <tr>
                        <td><strong>@day</strong></td>
                        <td>
                            <input type="checkbox" class="day-check" id="check_@day" data-day="@day"
                                   @(isWorking ? "checked" : "") style="accent-color:var(--brand-green);width:16px;height:16px;" />
                        </td>
                        <td>
                            <input type="time" class="gw-input start-time" id="start_@day"
                                   value="@(existing != null ? existing.StartTime.ToString(@"hh\:mm") : "09:00")"
                                   @(!isWorking ? "disabled" : "") style="max-width:130px;" />
                        </td>
                        <td>
                            <input type="time" class="gw-input end-time" id="end_@day"
                                   value="@(existing != null ? existing.EndTime.ToString(@"hh\:mm") : "17:00")"
                                   @(!isWorking ? "disabled" : "") style="max-width:130px;" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div id="scheduleData"></div>

        <div style="display:flex;gap:10px;">
            <button type="submit" class="btn-gw-primary" onclick="prepareSubmit()"><i class="bi bi-check-lg"></i> Save Schedule</button>
            <a asp-action="DoctorDetails" asp-route-id="@Model.Id" class="btn-gw-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.day-check').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var day = this.dataset.day;
                document.getElementById('start_' + day).disabled = !this.checked;
                document.getElementById('end_' + day).disabled = !this.checked;
            });
        });

        function prepareSubmit() {
            var container = document.getElementById('scheduleData');
            container.innerHTML = '';
            var index = 0;
            document.querySelectorAll('.day-check').forEach(function (cb) {
                if (cb.checked) {
                    var day = cb.dataset.day;
                    var start = document.getElementById('start_' + day).value;
                    var end = document.getElementById('end_' + day).value;
                    container.innerHTML +=
                        '<input type="hidden" name="WorkingDays[' + index + ']" value="' + day + '" />' +
                        '<input type="hidden" name="StartTimes[' + index + ']" value="' + start + '" />' +
                        '<input type="hidden" name="EndTimes[' + index + ']" value="' + end + '" />';
                    index++;
                }
            });
        }
    </script>
}
