@model ClinicSystem.Api.Models.Doctor
@{
    ViewData["Title"] = "Edit Doctor";
    var selectedSpecs = ViewBag.SelectedSpecializations as List<int>;
}

<div class="container mt-4">
    <h2>Edit Doctor</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="EditDoctor" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <h5>Account Details</h5>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input name="FullName" value="@Model.User.FullName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input value="@Model.User.Email" class="form-control" disabled />
                    <small class="text-muted">Email cannot be changed here.</small>
                </div>

                <hr />
                <h5>Doctor Profile</h5>

                <div class="mb-3">
                    <label class="form-label">License Number</label>
                    <input name="LicenseNumber" value="@Model.LicenseNumber" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Bio</label>
                    <textarea name="Bio" class="form-control" rows="3">@Model.Bio</textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Years of Experience</label>
                        <input name="YearsOfExperience" type="number" min="0"
                               value="@Model.YearsOfExperience" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Consultation Fee (BD)</label>
                        <input name="ConsultationFee" type="number" step="0.01" min="0"
                               value="@Model.ConsultationFee" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="IsAvailable" value="true"
                               @(Model.IsAvailable ? "checked" : "") />
                        <label class="form-check-label">Available for appointments</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Specializations</label>
                    <div class="row">
                        @foreach (var spec in ViewBag.Specializations as List<ClinicSystem.Api.Models.Specialization>)
                        {
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedSpecializations" value="@spec.Id"
                                           @(selectedSpecs.Contains(spec.Id) ? "checked" : "") />
                                    <label class="form-check-label">@spec.Name</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-warning">Save Changes</button>
                <a asp-action="DoctorList" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>