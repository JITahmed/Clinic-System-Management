@model ClinicSystem.Api.Models.Doctor
@{
    ViewData["Title"] = "Edit Doctor";
    var selectedSpecs = ViewBag.SelectedSpecializations as List<int>;
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Edit Doctor</h2>
        <p>Update profile for Dr. @Model.User.FullName</p>
    </div>
    <a asp-action="DoctorList" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div style="max-width:700px;">
    <form asp-action="EditDoctor" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <div class="gw-card" style="margin-bottom:20px;">
            <div class="gw-card-header"><span class="gw-card-title">Account Details</span></div>
            <div class="gw-form-group">
                <label class="gw-label">Full Name</label>
                <input name="FullName" value="@Model.User.FullName" class="gw-input" required />
            </div>
            <div class="gw-form-group" style="margin-bottom:0;">
                <label class="gw-label">Email</label>
                <input value="@Model.User.Email" class="gw-input" disabled style="opacity:0.6;" />
                <small class="text-muted-gw" style="font-size:0.78rem;margin-top:4px;display:block;">Email cannot be changed here.</small>
            </div>
        </div>

        <div class="gw-card" style="margin-bottom:20px;">
            <div class="gw-card-header"><span class="gw-card-title">Doctor Profile</span></div>
            <div class="gw-form-group">
                <label class="gw-label">License Number</label>
                <input name="LicenseNumber" value="@Model.LicenseNumber" class="gw-input" required />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">Bio</label>
                <textarea name="Bio" class="gw-textarea">@Model.Bio</textarea>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="gw-form-group" style="margin-bottom:0;">
                    <label class="gw-label">Years of Experience</label>
                    <input name="YearsOfExperience" type="number" min="0" value="@Model.YearsOfExperience" class="gw-input" required />
                </div>
                <div class="gw-form-group" style="margin-bottom:0;">
                    <label class="gw-label">Consultation Fee (BD)</label>
                    <input name="ConsultationFee" type="number" step="0.01" min="0" value="@Model.ConsultationFee" class="gw-input" required />
                </div>
            </div>
            <div class="gw-form-group" style="margin-top:16px;margin-bottom:0;">
                <label style="display:flex;align-items:center;gap:8px;font-size:0.875rem;cursor:pointer;">
                    <input type="checkbox" name="IsAvailable" value="true" @(Model.IsAvailable ? "checked" : "") style="accent-color:var(--brand-green);" />
                    Available for appointments
                </label>
            </div>
        </div>

        <div class="gw-card" style="margin-bottom:20px;">
            <div class="gw-card-header"><span class="gw-card-title">Specializations</span></div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
                @foreach (var spec in ViewBag.Specializations as List<ClinicSystem.Api.Models.Specialization>)
                {
                    <label style="display:flex;align-items:center;gap:8px;font-size:0.875rem;cursor:pointer;">
                        <input type="checkbox" name="SelectedSpecializations" value="@spec.Id"
                               @(selectedSpecs.Contains(spec.Id) ? "checked" : "") style="accent-color:var(--brand-green);" />
                        @spec.Name
                    </label>
                }
            </div>
        </div>

        <div style="display:flex;gap:10px;">
            <button type="submit" class="btn-gw-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
            <a asp-action="DoctorList" class="btn-gw-secondary">Cancel</a>
        </div>
    </form>
</div>
