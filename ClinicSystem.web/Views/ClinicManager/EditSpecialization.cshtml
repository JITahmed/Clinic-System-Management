@model ClinicSystem.Api.Models.Specialization
@{
    ViewData["Title"] = "Edit Specialization";
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Edit Specialization</h2>
    </div>
    <a asp-action="SpecializationList" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div style="max-width:500px;">
    <div class="gw-card">
        <form asp-action="EditSpecialization" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="gw-alert gw-alert-danger mb-4"></div>
            <div class="gw-form-group">
                <label asp-for="Name" class="gw-label"></label>
                <input asp-for="Name" class="gw-input" />
                <span asp-validation-for="Name" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div class="gw-form-group">
                <label asp-for="Description" class="gw-label"></label>
                <textarea asp-for="Description" class="gw-textarea"></textarea>
                <span asp-validation-for="Description" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div style="display:flex;gap:10px;">
                <button type="submit" class="btn-gw-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="SpecializationList" class="btn-gw-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
