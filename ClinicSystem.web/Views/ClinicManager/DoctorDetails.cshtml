@model ClinicSystem.Api.Models.Doctor
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Dr. @Model.User.FullName</h2>
        <p>Full profile, schedule, and leave periods.</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a asp-action="EditDoctor" asp-route-id="@Model.Id" class="btn-gw-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="DoctorList" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    <div class="gw-card">
        <div class="gw-card-header">
            <span class="gw-card-title">Profile</span>
            @if (Model.IsAvailable)
            {
                <span class="gw-badge badge-active">Available</span>
            }
            else
            {
                <span class="gw-badge badge-inactive">Unavailable</span>
            }
        </div>
        <table style="width:100%;font-size:0.875rem;border-collapse:collapse;">
            <tr><td style="padding:6px 0;color:var(--text-muted);width:40%;">Email</td><td>@Model.User.Email</td></tr>
            <tr><td style="padding:6px 0;color:var(--text-muted);">License</td><td>@Model.LicenseNumber</td></tr>
            <tr><td style="padding:6px 0;color:var(--text-muted);">Experience</td><td>@Model.YearsOfExperience years</td></tr>
            <tr><td style="padding:6px 0;color:var(--text-muted);">Fee</td><td>BD @Model.ConsultationFee</td></tr>
            <tr><td style="padding:6px 0;color:var(--text-muted);vertical-align:top;">Bio</td><td>@Model.Bio</td></tr>
        </table>
    </div>

    <div class="gw-card">
        <div class="gw-card-header"><span class="gw-card-title">Specializations</span></div>
        @if (!Model.DoctorSpecializations.Any())
        {
            <p class="text-muted-gw" style="font-size:0.875rem;">No specializations assigned.</p>
        }
        else
        {
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
                @foreach (var ds in Model.DoctorSpecializations)
                {
                    <span class="gw-badge badge-confirmed">@ds.Specialization.Name</span>
                }
            </div>
        }
    </div>

    <div class="gw-card">
        <div class="gw-card-header">
            <span class="gw-card-title">Weekly Schedule</span>
            <a asp-action="ManageSchedule" asp-route-id="@Model.Id" class="btn-gw-secondary btn-gw-sm"><i class="bi bi-pencil"></i> Edit Schedule</a>
        </div>
        @if (!Model.Schedules.Any())
        {
            <p class="text-muted-gw" style="font-size:0.875rem;">No schedule set.</p>
        }
        else
        {
            <table class="gw-table">
                <thead><tr><th>Day</th><th>Start</th><th>End</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Schedules.Where(s => s.IsActive))
                    {
                        <tr>
                            <td>@s.DayOfWeek</td>
                            <td>@s.StartTime.ToString(@"hh\:mm")</td>
                            <td>@s.EndTime.ToString(@"hh\:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="gw-card">
        <div class="gw-card-header">
            <span class="gw-card-title">Leave Periods</span>
            <a asp-action="ManageLeave" asp-route-id="@Model.Id" class="btn-gw-secondary btn-gw-sm"><i class="bi bi-calendar-x"></i> Manage Leave</a>
        </div>
        @if (!Model.Leaves.Any())
        {
            <p class="text-muted-gw" style="font-size:0.875rem;">No leave periods recorded.</p>
        }
        else
        {
            <table class="gw-table">
                <thead><tr><th>From</th><th>To</th><th>Reason</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Leaves)
                    {
                        <tr>
                            <td>@l.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@l.EndDate.ToString("dd MMM yyyy")</td>
                            <td>@l.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
