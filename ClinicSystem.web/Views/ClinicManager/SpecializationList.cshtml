@model IEnumerable<ClinicSystem.Api.Models.Specialization>
@{
    ViewData["Title"] = "Specializations";
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Specializations</h2>
        <p>Manage all medical specializations offered at the clinic.</p>
    </div>
    <a asp-action="CreateSpecialization" class="btn-gw-primary"><i class="bi bi-plus-lg"></i> Add Specialization</a>
</div>

@if (!Model.Any())
{
    <div class="gw-card">
        <div class="gw-empty">
            <div class="gw-empty-icon"><i class="bi bi-clipboard2-pulse"></i></div>
            <p>No specializations found. Add one to get started.</p>
        </div>
    </div>
}
else
{
    <div class="gw-table-wrap">
        <table class="gw-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-muted-gw">@s.Id</td>
                        <td><span class="fw-600">@s.Name</span></td>
                        <td class="text-muted-gw">@s.Description</td>
                        <td>
                            <div style="display:flex;gap:6px;">
                                <a asp-action="EditSpecialization" asp-route-id="@s.Id" class="btn-gw-secondary btn-gw-sm"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="DeleteSpecialization" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this specialization?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-gw-danger btn-gw-sm"><i class="bi bi-trash"></i> Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
