@model ClinicSystem.Api.Models.ApplicationUser
@{
    ViewData["Title"] = "Change User Role";
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Change Role</h2>
        <p>Update role for @Model.FullName</p>
    </div>
    <a asp-action="UserList" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back to Users</a>
</div>

<div style="max-width:420px;">
    <div class="gw-card">
        <div style="margin-bottom:16px;font-size:0.875rem;">
            <div class="text-muted-gw" style="margin-bottom:4px;">Email</div>
            <strong>@Model.Email</strong>
        </div>
        <div style="margin-bottom:20px;">
            <div class="text-muted-gw" style="font-size:0.875rem;margin-bottom:6px;">Current Role</div>
            <span class="gw-badge badge-confirmed">@ViewBag.CurrentRole</span>
        </div>
        <form asp-action="EditUserRole" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@Model.Id" />
            <div class="gw-form-group">
                <label class="gw-label">New Role</label>
                <select name="NewRole" class="gw-select">
                    <option value="Patient">Patient</option>
                    <option value="Doctor">Doctor</option>
                    <option value="Receptionist">Receptionist</option>
                    <option value="ClinicManager">Clinic Manager</option>
                </select>
            </div>
            <button type="submit" class="btn-gw-primary" style="width:100%;"><i class="bi bi-check-lg"></i> Update Role</button>
        </form>
    </div>
</div>
