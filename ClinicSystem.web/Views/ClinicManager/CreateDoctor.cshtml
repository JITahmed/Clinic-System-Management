@{
    ViewData["Title"] = "Add Doctor";
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Add Doctor</h2>
        <p>Create a new doctor account and profile.</p>
    </div>
    <a asp-action="DoctorList" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div style="max-width:700px;">
    <form asp-action="CreateDoctor" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="gw-alert gw-alert-danger mb-4"></div>

        <div class="gw-card" style="margin-bottom:20px;">
            <div class="gw-card-header"><span class="gw-card-title">Account Details</span></div>
            <div class="gw-form-group">
                <label class="gw-label">Full Name</label>
                <input name="FullName" class="gw-input" required />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">Email</label>
                <input name="Email" type="email" class="gw-input" required />
            </div>
            <div class="gw-form-group" style="margin-bottom:0;">
                <label class="gw-label">Password</label>
                <input name="Password" type="password" class="gw-input" required />
                <small class="text-muted-gw" style="font-size:0.78rem;margin-top:4px;display:block;">Minimum 6 characters, at least one digit.</small>
            </div>
        </div>

        <div class="gw-card" style="margin-bottom:20px;">
            <div class="gw-card-header"><span class="gw-card-title">Doctor Profile</span></div>
            <div class="gw-form-group">
                <label class="gw-label">License Number</label>
                <input name="LicenseNumber" class="gw-input" required />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">Bio</label>
                <textarea name="Bio" class="gw-textarea"></textarea>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="gw-form-group" style="margin-bottom:0;">
                    <label class="gw-label">Years of Experience</label>
                    <input name="YearsOfExperience" type="number" min="0" class="gw-input" required />
                </div>
                <div class="gw-form-group" style="margin-bottom:0;">
                    <label class="gw-label">Consultation Fee (BD)</label>
                    <input name="ConsultationFee" type="number" step="0.01" min="0" class="gw-input" required />
                </div>
            </div>
        </div>

        <div class="gw-card" style="margin-bottom:20px;">
            <div class="gw-card-header"><span class="gw-card-title">Specializations</span></div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
                @foreach (var spec in ViewBag.Specializations as List<ClinicSystem.Api.Models.Specialization>)
                {
                    <label style="display:flex;align-items:center;gap:8px;font-size:0.875rem;cursor:pointer;">
                        <input type="checkbox" name="SelectedSpecializations" value="@spec.Id" style="accent-color:var(--brand-green);" />
                        @spec.Name
                    </label>
                }
            </div>
        </div>

        <div style="display:flex;gap:10px;">
            <button type="submit" class="btn-gw-primary"><i class="bi bi-check-lg"></i> Create Doctor</button>
            <a asp-action="DoctorList" class="btn-gw-secondary">Cancel</a>
        </div>
    </form>
</div>
