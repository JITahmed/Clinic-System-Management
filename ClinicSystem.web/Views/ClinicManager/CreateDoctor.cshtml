@{
    ViewData["Title"] = "Add Doctor";
}

<div class="container mt-4">
    <h2>Add Doctor</h2>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-8">
            <form asp-action="CreateDoctor" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <h5>Account Details</h5>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input name="FullName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="Email" type="email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input name="Password" type="password" class="form-control" required />
                    <small class="text-muted">Minimum 6 characters, at least one digit.</small>
                </div>

                <hr />
                <h5>Doctor Profile</h5>

                <div class="mb-3">
                    <label class="form-label">License Number</label>
                    <input name="LicenseNumber" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Bio</label>
                    <textarea name="Bio" class="form-control" rows="3"></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Years of Experience</label>
                        <input name="YearsOfExperience" type="number" min="0" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Consultation Fee (BD)</label>
                        <input name="ConsultationFee" type="number" step="0.01" min="0" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Specializations</label>
                    <div class="row">
                        @foreach (var spec in ViewBag.Specializations as List<ClinicSystem.Api.Models.Specialization>)
                        {
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedSpecializations" value="@spec.Id" />
                                    <label class="form-check-label">@spec.Name</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Create Doctor</button>
                <a asp-action="DoctorList" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>