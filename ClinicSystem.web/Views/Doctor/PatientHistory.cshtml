@model IEnumerable<ClinicSystem.Api.Models.VisitRecord>
@{
    ViewData["Title"] = "Patient History";
    var patient = ViewBag.Patient as ClinicSystem.Api.Models.Patient;
    int age = DateTime.Today.Year - patient!.DateOfBirth.Year;
    if (patient.DateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Patient History</h5>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Back</a>
    </div>

    <div class="card mb-4 border-0 bg-light">
        <div class="card-body">
            <div class="row">
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Name</div>
                    <strong>@patient.User.FullName</strong>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Age</div>
                    @age years
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Blood Type</div>
                    @(string.IsNullOrEmpty(patient.BloodType) ? "N/A" : patient.BloodType)
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Allergies</div>
                    @if (!string.IsNullOrWhiteSpace(patient.Allergies))
                    {
                        <span class="badge bg-danger">@patient.Allergies</span>
                    }
                    else
                    {
                        <span class="text-muted">None recorded</span>
                    }
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small">Total Visits</div>
                    @Model.Count()
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <p>No completed visits on record for this patient.</p>
        </div>
    }
    else
    {
        foreach (var visit in Model)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@visit.VisitDate.ToString("MMMM dd, yyyy")</strong>
                    <div class="d-flex gap-2 align-items-center">
                        <small class="text-muted">Dr. @visit.Appointment.Doctor.User.FullName</small>
                        @if (visit.Prescriptions.Any())
                        {
                            <a asp-action="Prescriptions" asp-route-id="@visit.Id"
                               class="btn btn-outline-secondary btn-sm">
                                View Rx (@visit.Prescriptions.Count)
                            </a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-muted small mb-1">Diagnosis</div>
                            <p class="mb-0">@visit.Diagnosis</p>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small mb-1">Clinical Notes</div>
                            <p class="mb-0">@visit.DoctorNotes</p>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small mb-1">Treatment Plan</div>
                            <p class="mb-0">@(string.IsNullOrEmpty(visit.TreatmentPlan) ? "—" : visit.TreatmentPlan)</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
