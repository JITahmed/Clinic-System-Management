@model IEnumerable<ClinicSystem.Api.Models.VisitRecord>
@{
    ViewData["Title"] = "Patient History";
    var patient = ViewBag.Patient as ClinicSystem.Api.Models.Patient;
    int age = DateTime.Today.Year - patient!.DateOfBirth.Year;
    if (patient.DateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
}

<div class="gw-page-header">
    <h2>Patient History</h2>
    <p>@patient.User.FullName — full visit records.</p>
</div>

<div class="gw-card" style="margin-bottom:20px;">
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:16px;font-size:0.875rem;">
        <div><div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:3px;">Name</div><strong>@patient.User.FullName</strong></div>
        <div><div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:3px;">Age</div>@age years</div>
        <div><div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:3px;">Blood Type</div>@(string.IsNullOrEmpty(patient.BloodType) ? "N/A" : patient.BloodType)</div>
        <div>
            <div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:3px;">Allergies</div>
            @if (!string.IsNullOrWhiteSpace(patient.Allergies))
            {
                <span class="gw-badge badge-cancelled">@patient.Allergies</span>
            }
            else
            {
                <span class="text-muted-gw">None</span>
            }
        </div>
        <div><div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:3px;">Total Visits</div><strong>@Model.Count()</strong></div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="gw-card">
        <div class="gw-empty"><p>No completed visits on record for this patient.</p></div>
    </div>
}
else
{
    @foreach (var visit in Model)
    {
        <div class="gw-card" style="margin-bottom:16px;">
            <div class="gw-card-header">
                <span class="fw-600">@visit.VisitDate.ToString("MMMM dd, yyyy")</span>
                <div style="display:flex;align-items:center;gap:12px;">
                    <span class="text-muted-gw" style="font-size:0.875rem;">Dr. @visit.Appointment.Doctor.User.FullName</span>
                    @if (visit.Prescriptions.Any())
                    {
                        <a asp-action="Prescriptions" asp-route-id="@visit.Id" class="btn-gw-secondary btn-gw-sm">
                            <i class="bi bi-capsule"></i> Rx (@visit.Prescriptions.Count)
                        </a>
                    }
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;font-size:0.875rem;">
                <div>
                    <div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:4px;">Diagnosis</div>
                    <p style="margin:0;">@visit.Diagnosis</p>
                </div>
                <div>
                    <div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:4px;">Clinical Notes</div>
                    <p style="margin:0;">@visit.DoctorNotes</p>
                </div>
                <div>
                    <div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:4px;">Treatment Plan</div>
                    <p style="margin:0;">@(string.IsNullOrEmpty(visit.TreatmentPlan) ? "—" : visit.TreatmentPlan)</p>
                </div>
            </div>
        </div>
    }
}
