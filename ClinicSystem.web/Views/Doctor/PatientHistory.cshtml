@model IEnumerable<ClinicSystem.Api.Models.VisitRecord>
@{
    ViewData["Title"] = "Patient History";
    var patient = ViewBag.Patient as ClinicSystem.Api.Models.Patient;
    int age = DateTime.Today.Year - patient!.DateOfBirth.Year;
    if (patient.DateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
}

<div class="page-shell">
    <div class="page-header">
        <h2>Patient History</h2>
        <p>Full medical visit history for this patient.</p>
    </div>

    <div class="section-card mb-4">
        <div class="section-card-header">
            <h5>Patient Information</h5>
        </div>
        <div class="section-card-body">
            <div class="row">
                <div class="col-6 col-md-3">
                    <div class="text-muted small mb-1">Name</div>
                    <strong>@patient.User.FullName</strong>
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small mb-1">Age</div>
                    @age years
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small mb-1">Blood Type</div>
                    @(string.IsNullOrEmpty(patient.BloodType) ? "N/A" : patient.BloodType)
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small mb-1">Allergies</div>
                    @if (!string.IsNullOrWhiteSpace(patient.Allergies))
                    {
                        <span class="badge-soft-danger">@patient.Allergies</span>
                    }
                    else
                    {
                        <span class="text-muted">None recorded</span>
                    }
                </div>
                <div class="col-6 col-md-2">
                    <div class="text-muted small mb-1">Total Visits</div>
                    @Model.Count()
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h5 class="mb-2">No visit records</h5>
            <p class="mb-0">No completed visits on record for this patient.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var visit in Model)
            {
                <div class="col-md-6">
                    <div class="section-card mb-0">
                        <div class="section-card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@visit.VisitDate.ToString("MMMM dd, yyyy")</h5>
                            @if (visit.Prescriptions.Any())
                            {
                                <a asp-action="Prescriptions" asp-route-id="@visit.Id"
                                   class="btn soft-btn btn-soft-secondary btn-sm btn-arrow">
                                    Rx (@visit.Prescriptions.Count) <span>→</span>
                                </a>
                            }
                        </div>
                        <div class="section-card-body">
                            <p class="text-muted mb-2">Dr. @visit.Appointment.Doctor.User.FullName</p>
                            <p class="mb-2">
                                <strong>Diagnosis:</strong>
                                <span class="text-muted">@visit.Diagnosis</span>
                            </p>
                            <p class="mb-2">
                                <strong>Notes:</strong>
                                <span class="text-muted">@visit.DoctorNotes</span>
                            </p>
                            <p class="mb-0">
                                <strong>Treatment:</strong>
                                <span class="text-muted">@(string.IsNullOrEmpty(visit.TreatmentPlan) ? "—" : visit.TreatmentPlan)</span>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to Dashboard
        </a>
    </div>
</div>