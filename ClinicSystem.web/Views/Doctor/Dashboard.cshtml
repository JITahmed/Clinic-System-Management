@model IEnumerable<ClinicSystem.Api.Models.Appointment>
@{
    ViewData["Title"] = "Dashboard";
    var doctor = ViewBag.Doctor as ClinicSystem.Api.Models.Doctor;
    int unread = ViewBag.UnreadCount ?? 0;
}

<div class="gw-page-header">
    <h2>Dr. @doctor?.User?.FullName</h2>
    <p>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
</div>

<div class="gw-stat-grid" style="margin-bottom:24px;">
    <div class="gw-stat">
        <div class="gw-stat-icon teal"><i class="bi bi-calendar2-day-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@Model.Count()</div>
            <div class="gw-stat-label">Total Today</div>
        </div>
    </div>
    <div class="gw-stat">
        <div class="gw-stat-icon orange"><i class="bi bi-door-open-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@Model.Count(a => a.Status == ClinicSystem.Api.Models.AppointmentStatus.CheckedIn)</div>
            <div class="gw-stat-label">Checked In</div>
        </div>
    </div>
    <div class="gw-stat">
        <div class="gw-stat-icon green"><i class="bi bi-check-circle-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@Model.Count(a => a.Status == ClinicSystem.Api.Models.AppointmentStatus.Completed)</div>
            <div class="gw-stat-label">Completed</div>
        </div>
    </div>
    <div class="gw-stat">
        <div class="gw-stat-icon navy"><i class="bi bi-calendar-check-fill"></i></div>
        <div class="gw-stat-info">
            <div class="gw-stat-value">@Model.Count(a => a.Status == ClinicSystem.Api.Models.AppointmentStatus.Confirmed)</div>
            <div class="gw-stat-label">Confirmed</div>
        </div>
    </div>
</div>

<div class="gw-card">
    <div class="gw-card-header">
        <span class="gw-card-title">Today's Appointments</span>
    </div>
    @if (!Model.Any())
    {
        <div class="gw-empty">
            <div class="gw-empty-icon"><i class="bi bi-calendar2"></i></div>
            <p>No appointments scheduled for today.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="gw-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@appt.StartTime.ToString(@"hh\:mm") – @appt.EndTime.ToString(@"hh\:mm")</td>
                            <td><span class="fw-600">@appt.Patient.User.FullName</span></td>
                            <td>@appt.ReasonForVisit</td>
                            <td>
                                @switch (appt.Status)
                                {
                                    case ClinicSystem.Api.Models.AppointmentStatus.CheckedIn:
                                        <span class="gw-badge badge-checkedin">Checked In</span>
                                        break;
                                    case ClinicSystem.Api.Models.AppointmentStatus.InProgress:
                                        <span class="gw-badge badge-inprogress">In Progress</span>
                                        break;
                                    case ClinicSystem.Api.Models.AppointmentStatus.Completed:
                                        <span class="gw-badge badge-completed">Completed</span>
                                        break;
                                    case ClinicSystem.Api.Models.AppointmentStatus.Confirmed:
                                        <span class="gw-badge badge-confirmed">Confirmed</span>
                                        break;
                                    case ClinicSystem.Api.Models.AppointmentStatus.Cancelled:
                                        <span class="gw-badge badge-cancelled">Cancelled</span>
                                        break;
                                    default:
                                        <span class="gw-badge badge-requested">@appt.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (appt.Status == ClinicSystem.Api.Models.AppointmentStatus.CheckedIn ||
                                                        appt.Status == ClinicSystem.Api.Models.AppointmentStatus.InProgress)
                                {
                                    <a asp-action="Consultation" asp-route-id="@appt.Id" class="btn-gw-primary btn-gw-sm"><i class="bi bi-play-fill"></i> Start</a>
                                }
                                else if (appt.Status == ClinicSystem.Api.Models.AppointmentStatus.Completed)
                                {
                                    <a asp-action="PatientHistory" asp-route-id="@appt.PatientId" class="btn-gw-secondary btn-gw-sm"><i class="bi bi-clock-history"></i> History</a>
                                }
                                else
                                {
                                    <button class="btn-gw-secondary btn-gw-sm" disabled style="opacity:0.5;">Waiting</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
