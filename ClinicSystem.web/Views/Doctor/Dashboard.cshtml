@using ClinicSystem.Api.Models
@model IEnumerable<ClinicSystem.Api.Models.Appointment>
@{
    ViewData["Title"] = "Doctor Dashboard";
    var doctor = ViewBag.Doctor as ClinicSystem.Api.Models.Doctor;
    int totalToday = ViewBag.TotalToday ?? 0;
    int upcomingCount = ViewBag.UpcomingCount ?? 0;
    int completedToday = ViewBag.CompletedToday ?? 0;
    int checkedIn = ViewBag.CheckedIn ?? 0;
    int unreadCount = ViewBag.UnreadCount ?? 0;
    string latestNotificationTitle = ViewBag.LatestNotificationTitle ?? "No recent notifications";
}

<div class="page-shell">
    <div class="page-header">
        <h2>Dr. @doctor?.User?.FullName</h2>
        <p>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 shadow-sm">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-3 shadow-sm">@TempData["ErrorMessage"]</div>
    }

    <div class="patient-summary">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="summary-item">
                    <div class="summary-icon icon-blue">
                        <i class="bi bi-calendar2-day-fill"></i>
                    </div>
                    <div class="summary-content">
                        <h6>Today's Total</h6>
                        <h3>@totalToday</h3>
                        <p>Scheduled today</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 summary-divider">
                <div class="summary-item">
                    <div class="summary-icon icon-orange">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div class="summary-content">
                        <h6>Checked In</h6>
                        <h3>@checkedIn</h3>
                        <p>Waiting to be seen</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 summary-divider">
                <div class="summary-item">
                    <div class="summary-icon icon-green">
                        <i class="bi bi-clipboard2-pulse-fill"></i>
                    </div>
                    <div class="summary-content">
                        <h6>Completed Today</h6>
                        <h3>@completedToday</h3>
                        <p>Visits completed</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 summary-divider">
                <a asp-action="Notifications" class="text-decoration-none text-reset">
                    <div class="summary-item">
                        <div class="summary-icon icon-dark">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                        <div class="summary-content">
                            <h6>Notifications</h6>
                            <h3>@unreadCount</h3>
                            <p>@latestNotificationTitle</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="feature-card">
                <div class="feature-head">
                    <div class="feature-icon icon-blue">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div class="feature-text">
                        <h5>Upcoming Appointments</h5>
                        <p>View all your confirmed and requested future appointments.</p>
                    </div>
                </div>
                <a asp-action="UpcomingAppointments" class="btn soft-btn btn-soft-primary btn-arrow">
                    View Upcoming <span>→</span>
                </a>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="feature-card">
                <div class="feature-head">
                    <div class="feature-icon icon-teal">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div class="feature-text">
                        <h5>My Schedule</h5>
                        <p>Review your working hours and any upcoming leave periods.</p>
                    </div>
                </div>
                <a asp-action="MySchedule" class="btn soft-btn btn-soft-info btn-arrow">
                    View Schedule <span>→</span>
                </a>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="feature-card">
                <div class="feature-head">
                    <div class="feature-icon icon-dark">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <div class="feature-text">
                        <h5>Notifications</h5>
                        <p>View your appointment and system notifications.</p>
                    </div>
                </div>
                <a asp-action="Notifications" class="btn soft-btn btn-soft-dark btn-arrow">
                    View Notifications <span>→</span>
                </a>
            </div>
        </div>
    </div>

    <div class="section-card">
        <div class="section-card-header">
            <h5>Today's Appointments</h5>
        </div>
        <div class="section-card-body">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <h5 class="mb-2">No appointments today</h5>
                    <p class="mb-0">You have no appointments scheduled for today.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model)
                            {
                                <tr>
                                    <td>@appt.StartTime.ToString(@"hh\:mm") – @appt.EndTime.ToString(@"hh\:mm")</td>
                                    <td><strong>@appt.Patient.User.FullName</strong></td>
                                    <td>@appt.ReasonForVisit</td>
                                    <td>
                                        @switch (appt.Status)
                                        {
                                            case AppointmentStatus.CheckedIn:
                                                <span class="badge-soft-warning">Checked In</span>
                                                break;
                                            case AppointmentStatus.InProgress:
                                                <span class="badge-soft-info">In Progress</span>
                                                break;
                                            case AppointmentStatus.Completed:
                                                <span class="badge-soft-success">Completed</span>
                                                break;
                                            case AppointmentStatus.Confirmed:
                                                <span class="badge-soft-info">Confirmed</span>
                                                break;
                                            case AppointmentStatus.Cancelled:
                                                <span class="badge-soft-danger">Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge-soft-info">@appt.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (appt.Status == AppointmentStatus.CheckedIn || appt.Status == AppointmentStatus.InProgress)
                                        {
                                            <a asp-action="Consultation" asp-route-id="@appt.Id"
                                               class="btn soft-btn btn-soft-primary btn-sm btn-arrow">
                                                Start <span>→</span>
                                            </a>
                                        }
                                        else if (appt.Status == AppointmentStatus.Completed)
                                        {
                                            <a asp-action="PatientHistory" asp-route-id="@appt.PatientId"
                                               class="btn soft-btn btn-soft-secondary btn-sm btn-arrow">
                                                History <span>→</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Waiting</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>