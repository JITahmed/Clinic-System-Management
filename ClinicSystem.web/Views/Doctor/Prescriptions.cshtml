@model ClinicSystem.Api.Models.VisitRecord
@{
    ViewData["Title"] = "Prescriptions";
    var patientName = Model.Appointment.Patient.User.FullName;
}

<div class="page-shell">
    <div class="page-header">
        <h2>Prescriptions</h2>
        <p>@patientName — Visit on @Model.VisitDate.ToString("MMMM dd, yyyy") — @Model.Diagnosis</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 shadow-sm">@TempData["SuccessMessage"]</div>
    }

    <div class="section-card mb-4">
        <div class="section-card-header">
            <h5>Recorded Prescriptions</h5>
        </div>
        <div class="section-card-body">
            @if (!Model.Prescriptions.Any())
            {
                <div class="empty-state">
                    No prescriptions recorded for this visit.
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Duration</th>
                                <th>Instructions</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rx in Model.Prescriptions)
                            {
                                <tr>
                                    <td><strong>@rx.MedicationName</strong></td>
                                    <td>@rx.Dosage</td>
                                    <td>@rx.Frequency</td>
                                    <td>@rx.Duration</td>
                                    <td>@(string.IsNullOrEmpty(rx.Instructions) ? "—" : rx.Instructions)</td>
                                    <td>
                                        <form asp-action="DeletePrescription" method="post"
                                              onsubmit="return confirm('Remove this prescription?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="prescriptionId" value="@rx.Id" />
                                            <input type="hidden" name="visitRecordId" value="@Model.Id" />
                                            <button class="btn soft-btn btn-soft-danger btn-sm">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="section-card mb-4">
        <div class="section-card-header">
            <h5>Add Prescription</h5>
        </div>
        <div class="section-card-body">
            <form asp-action="AddPrescription" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="visitRecordId" value="@Model.Id" />
                <div class="form-card">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Medication *</label>
                            <input type="text" name="medicationName" class="form-control" placeholder="e.g., Amoxicillin" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Dosage</label>
                            <input type="text" name="dosage" class="form-control" placeholder="e.g., 500mg" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Frequency</label>
                            <input type="text" name="frequency" class="form-control" placeholder="e.g., Twice daily" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Duration</label>
                            <input type="text" name="duration" class="form-control" placeholder="e.g., 7 days" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Instructions</label>
                            <input type="text" name="instructions" class="form-control" placeholder="e.g., With food" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn soft-btn btn-soft-success">Add Prescription</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-2">
        <a asp-action="PatientHistory" asp-route-id="@Model.Appointment.PatientId"
           class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to History
        </a>
    </div>
</div>