@model IEnumerable<ClinicSystem.Api.Models.Appointment>
@{
    ViewData["Title"] = "Upcoming Appointments";
}

<div class="gw-page-header">
    <h2>Upcoming Appointments</h2>
    <p>All your confirmed and requested future appointments.</p>
</div>

@if (!Model.Any())
{
    <div class="gw-card">
        <div class="gw-empty">
            <div class="gw-empty-icon"><i class="bi bi-calendar2"></i></div>
            <p>No upcoming appointments.</p>
        </div>
    </div>
}
else
{
    <div class="gw-table-wrap">
        <table class="gw-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Reason</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model)
                {
                    <tr>
                        <td>@appt.AppointmentDate.ToString("MMM dd, yyyy")</td>
                        <td>@appt.StartTime.ToString(@"hh\:mm")</td>
                        <td><span class="fw-600">@appt.Patient.User.FullName</span></td>
                        <td>@appt.ReasonForVisit</td>
                        <td>
                            @if (appt.Status == ClinicSystem.Api.Models.AppointmentStatus.Confirmed)
                            {
                                <span class="gw-badge badge-confirmed">Confirmed</span>
                            }
                            else
                            {
                                <span class="gw-badge badge-requested">@appt.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
