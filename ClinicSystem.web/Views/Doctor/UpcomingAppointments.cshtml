@model IEnumerable<ClinicSystem.Api.Models.Appointment>
@{
    ViewData["Title"] = "Upcoming Appointments";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Upcoming Appointments</h5>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Back</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <p>No upcoming appointments.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Reason</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>@appt.AppointmentDate.ToString("MMM dd, yyyy")</td>
                                <td>@appt.StartTime.ToString(@"hh\:mm")</td>
                                <td>@appt.Patient.User.FullName</td>
                                <td>@appt.ReasonForVisit</td>
                                <td>
                                    @if (appt.Status == ClinicSystem.Api.Models.AppointmentStatus.Confirmed)
                                    {
                                        <span class="badge bg-info text-dark">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@appt.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
