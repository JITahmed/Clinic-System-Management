@using ClinicSystem.Api.Models
@model IEnumerable<ClinicSystem.Api.Models.Appointment>
@{
    ViewData["Title"] = "Upcoming Appointments";
}

<div class="page-shell">
    <div class="page-header">
        <h2>Upcoming Appointments</h2>
        <p>Your confirmed and requested future appointments.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h5 class="mb-2">No upcoming appointments</h5>
            <p class="mb-0">You have no confirmed or requested future appointments.</p>
        </div>
    }
    else
    {
        <div class="section-card">
            <div class="section-card-header">
                <h5>Your Upcoming Appointments</h5>
            </div>
            <div class="section-card-body">
                <div class="table-wrap">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Reason</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model)
                            {
                                <tr>
                                    <td>@appt.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                    <td>@appt.StartTime.ToString(@"hh\:mm")</td>
                                    <td>@appt.Patient.User.FullName</td>
                                    <td>@appt.ReasonForVisit</td>
                                    <td>
                                        @if (appt.Status == AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge-soft-success">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft-warning">Requested</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to Dashboard
        </a>
    </div>
</div>