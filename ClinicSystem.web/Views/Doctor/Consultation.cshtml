@model ClinicSystem.web.Models.ConsultationViewModel
@{
    ViewData["Title"] = "Consultation";
    int age = DateTime.Today.Year - Model.PatientDateOfBirth.Year;
    if (Model.PatientDateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
}

<div class="gw-action-bar">
    <div class="gw-page-header" style="margin-bottom:0;">
        <h2>Consultation Room</h2>
    </div>
    <a asp-action="Dashboard" class="btn-gw-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="gw-card" style="margin-bottom:20px;border-left:3px solid var(--doctor-accent);">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;font-size:0.875rem;">
        <div>
            <div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:2px;">Patient</div>
            <strong>@Model.PatientName</strong>
            <span class="text-muted-gw" style="margin-left:8px;">@age yrs &bull; @Model.BloodType</span>
        </div>
        <div>
            <div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:2px;">Reason for Visit</div>
            @Model.ReasonForVisit
        </div>
        <div>
            <div class="text-muted-gw" style="font-size:0.75rem;margin-bottom:2px;">Allergies</div>
            @if (!string.IsNullOrWhiteSpace(Model.Allergies))
            {
                <span class="gw-badge badge-cancelled"><i class="bi bi-exclamation-triangle-fill"></i> @Model.Allergies</span>
            }
            else
            {
                <span class="text-muted-gw">None recorded</span>
            }
        </div>
    </div>
</div>

<form asp-action="SaveConsultation" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AppointmentId" />
    <input type="hidden" asp-for="PatientId" />
    <input type="hidden" asp-for="PatientName" />
    <input type="hidden" asp-for="ReasonForVisit" />
    <input type="hidden" asp-for="PatientDateOfBirth" />
    <input type="hidden" asp-for="BloodType" />
    <input type="hidden" asp-for="Allergies" />

    <div class="gw-card" style="margin-bottom:20px;">
        <div class="gw-card-header"><span class="gw-card-title">Clinical Notes</span></div>
        <div class="gw-form-group">
            <label class="gw-label">Symptoms & Observations <span style="color:#c62828;">*</span></label>
            <textarea asp-for="Symptoms" class="gw-textarea" placeholder="Describe presenting symptoms and clinical observations..."></textarea>
            <span asp-validation-for="Symptoms" class="text-danger" style="font-size:0.78rem;"></span>
        </div>
        <div class="gw-form-group">
            <label class="gw-label">Diagnosis <span style="color:#c62828;">*</span></label>
            <input type="text" asp-for="DiagnosisText" class="gw-input" placeholder="e.g., Acute Pharyngitis" />
            <span asp-validation-for="DiagnosisText" class="text-danger" style="font-size:0.78rem;"></span>
        </div>
        <div class="gw-form-group" style="margin-bottom:0;">
            <label class="gw-label">Treatment Plan</label>
            <textarea asp-for="TreatmentPlan" class="gw-textarea" placeholder="Rest, follow-up instructions, referrals..."></textarea>
        </div>
    </div>

    <div class="gw-card" style="margin-bottom:20px;">
        <div class="gw-card-header"><span class="gw-card-title">Prescription <span style="font-weight:400;color:var(--text-muted);font-size:0.82rem;">(optional)</span></span></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="gw-form-group">
                <label class="gw-label">Medication Name</label>
                <input type="text" asp-for="MedicationName" class="gw-input" placeholder="e.g., Amoxicillin" />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">Dosage</label>
                <input type="text" asp-for="Dosage" class="gw-input" placeholder="e.g., 500mg" />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">Frequency</label>
                <input type="text" asp-for="Frequency" class="gw-input" placeholder="e.g., Twice daily" />
            </div>
            <div class="gw-form-group">
                <label class="gw-label">Duration</label>
                <input type="text" asp-for="Duration" class="gw-input" placeholder="e.g., 7 days" />
            </div>
            <div class="gw-form-group" style="margin-bottom:0;grid-column:span 2;">
                <label class="gw-label">Special Instructions</label>
                <input type="text" asp-for="Instructions" class="gw-input" placeholder="e.g., Take with food" />
            </div>
        </div>
    </div>

    <div style="display:flex;justify-content:space-between;">
        <a asp-action="Dashboard" class="btn-gw-danger">Cancel</a>
        <button type="submit" class="btn-gw-primary"><i class="bi bi-check-lg"></i> Save &amp; Complete Visit</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
