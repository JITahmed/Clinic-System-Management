@model ClinicSystem.web.Models.ConsultationViewModel
@{
    ViewData["Title"] = "Consultation";
    int age = DateTime.Today.Year - Model.PatientDateOfBirth.Year;
    if (Model.PatientDateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
}

<div class="page-shell">
    <div class="page-header">
        <h2>Consultation Room</h2>
        <p>Record clinical notes, diagnosis, and prescriptions for this visit.</p>
    </div>

    <div class="section-card mb-4">
        <div class="section-card-header">
            <h5>Patient Information</h5>
        </div>
        <div class="section-card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="text-muted small mb-1">Name</div>
                    <strong>@Model.PatientName</strong>
                </div>
                <div class="col-md-2">
                    <div class="text-muted small mb-1">Age</div>
                    @age years
                </div>
                <div class="col-md-2">
                    <div class="text-muted small mb-1">Blood Type</div>
                    @(string.IsNullOrEmpty(Model.BloodType) ? "N/A" : Model.BloodType)
                </div>
                <div class="col-md-3">
                    <div class="text-muted small mb-1">Allergies</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Allergies))
                    {
                        <span class="badge-soft-danger">⚠ @Model.Allergies</span>
                    }
                    else
                    {
                        <span class="text-muted">None recorded</span>
                    }
                </div>
                <div class="col-md-2">
                    <div class="text-muted small mb-1">Reason</div>
                    @Model.ReasonForVisit
                </div>
            </div>
        </div>
    </div>

    <form asp-action="SaveConsultation" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AppointmentId" />
        <input type="hidden" asp-for="PatientId" />
        <input type="hidden" asp-for="PatientName" />
        <input type="hidden" asp-for="ReasonForVisit" />
        <input type="hidden" asp-for="PatientDateOfBirth" />
        <input type="hidden" asp-for="BloodType" />
        <input type="hidden" asp-for="Allergies" />

        <div class="section-card mb-4">
            <div class="section-card-header">
                <h5>Clinical Notes</h5>
            </div>
            <div class="section-card-body">
                <div class="form-card">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Symptoms &amp; Observations <span class="text-danger">*</span></label>
                        <textarea asp-for="Symptoms" class="form-control" rows="4"
                                  placeholder="Describe presenting symptoms and clinical observations..."></textarea>
                        <span asp-validation-for="Symptoms" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Diagnosis <span class="text-danger">*</span></label>
                        <input type="text" asp-for="DiagnosisText" class="form-control"
                               placeholder="e.g., Acute Pharyngitis" />
                        <span asp-validation-for="DiagnosisText" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">Treatment Plan</label>
                        <textarea asp-for="TreatmentPlan" class="form-control" rows="3"
                                  placeholder="Rest, follow-up instructions, referrals..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card mb-4">
            <div class="section-card-header">
                <h5>Prescription <span class="text-muted fw-normal" style="font-size:0.9rem">(optional)</span></h5>
            </div>
            <div class="section-card-body">
                <div class="form-card">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Medication Name</label>
                            <input type="text" asp-for="MedicationName" class="form-control" placeholder="e.g., Amoxicillin" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Dosage</label>
                            <input type="text" asp-for="Dosage" class="form-control" placeholder="e.g., 500mg" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Frequency</label>
                            <input type="text" asp-for="Frequency" class="form-control" placeholder="e.g., Twice daily" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Duration</label>
                            <input type="text" asp-for="Duration" class="form-control" placeholder="e.g., 7 days" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Special Instructions</label>
                            <input type="text" asp-for="Instructions" class="form-control" placeholder="e.g., Take with food" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mb-5">
            <a asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
                <span>←</span> Back to Dashboard
            </a>
            <button type="submit" class="btn soft-btn btn-soft-success btn-arrow">
                Save &amp; Complete Visit <span>→</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}