@model IEnumerable<ClinicSystem.Api.Models.DoctorSchedule>
@{
    ViewData["Title"] = "My Schedule";
    var leaves = ViewBag.Leaves as IEnumerable<ClinicSystem.Api.Models.DoctorLeave> ?? Enumerable.Empty<ClinicSystem.Api.Models.DoctorLeave>();
}

<div class="gw-page-header">
    <h2>My Schedule</h2>
    <p>Your working hours and upcoming leave periods.</p>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    <div class="gw-card">
        <div class="gw-card-header"><span class="gw-card-title">Working Hours</span></div>
        @if (!Model.Any())
        {
            <div class="gw-empty"><p>No schedule set. Contact the clinic manager.</p></div>
        }
        else
        {
            <table class="gw-table">
                <thead><tr><th>Day</th><th>Start</th><th>End</th></tr></thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.DayOfWeek</td>
                            <td>@s.StartTime.ToString(@"hh\:mm")</td>
                            <td>@s.EndTime.ToString(@"hh\:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="gw-card">
        <div class="gw-card-header"><span class="gw-card-title">Upcoming Leave</span></div>
        @if (!leaves.Any())
        {
            <div class="gw-empty"><p>No upcoming leave periods.</p></div>
        }
        else
        {
            <table class="gw-table">
                <thead><tr><th>From</th><th>To</th><th>Reason</th></tr></thead>
                <tbody>
                    @foreach (var l in leaves)
                    {
                        <tr>
                            <td>@l.StartDate.ToString("MMM dd")</td>
                            <td>@l.EndDate.ToString("MMM dd")</td>
                            <td>@l.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
