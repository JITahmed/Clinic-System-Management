@model IEnumerable<ClinicSystem.Api.Models.DoctorSchedule>
@{
    ViewData["Title"] = "My Schedule";
    var leaves = ViewBag.Leaves as IEnumerable<ClinicSystem.Api.Models.DoctorLeave>
                 ?? Enumerable.Empty<ClinicSystem.Api.Models.DoctorLeave>();
}

<div class="page-shell">
    <div class="page-header">
        <h2>My Schedule</h2>
        <p>Your clinic working hours and upcoming leave periods. Contact the clinic manager to make changes.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="section-card">
                <div class="section-card-header">
                    <h5>Working Hours</h5>
                </div>
                <div class="section-card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="empty-state m-3">
                            No working hours set. Contact the clinic manager.
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="table table-modern mb-0">
                                <thead>
                                    <tr>
                                        <th>Day</th>
                                        <th>Start</th>
                                        <th>End</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model)
                                    {
                                        <tr>
                                            <td>@s.DayOfWeek</td>
                                            <td>@s.StartTime.ToString(@"hh\:mm")</td>
                                            <td>@s.EndTime.ToString(@"hh\:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="section-card">
                <div class="section-card-header">
                    <h5>Upcoming Leave</h5>
                </div>
                <div class="section-card-body p-0">
                    @if (!leaves.Any())
                    {
                        <div class="empty-state m-3">
                            No upcoming leave periods.
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="table table-modern mb-0">
                                <thead>
                                    <tr>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in leaves)
                                    {
                                        <tr>
                                            <td>@l.StartDate.ToString("MMM dd, yyyy")</td>
                                            <td>@l.EndDate.ToString("MMM dd, yyyy")</td>
                                            <td>@l.Reason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to Dashboard
        </a>
    </div>
</div>