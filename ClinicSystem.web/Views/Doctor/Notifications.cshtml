@model IEnumerable<ClinicSystem.Api.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="gw-page-header">
    <h2>Notifications</h2>
    <p>Your recent clinic notifications.</p>
</div>

@if (!Model.Any())
{
    <div class="gw-card">
        <div class="gw-empty">
            <div class="gw-empty-icon"><i class="bi bi-bell"></i></div>
            <p>No notifications yet.</p>
        </div>
    </div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:12px;">
        @foreach (var n in Model)
        {
            <div class="gw-card" style="border-left:3px solid @(n.IsRead ? "var(--border)" : "var(--doctor-accent)");">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                    <div>
                        <div class="fw-600" style="margin-bottom:4px;">@n.Title</div>
                        <div class="text-muted-gw" style="font-size:0.875rem;">@n.Message</div>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                        <div style="font-size:0.78rem;color:var(--text-muted);">@n.CreatedAt.ToString("MMM dd, hh:mm tt")</div>
                        @if (!n.IsRead)
                        {
                            <span class="gw-badge badge-confirmed" style="margin-top:6px;display:inline-flex;">New</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
