@using ClinicSystem.Api.Models
@model IEnumerable<ClinicSystem.Api.Models.Appointment>

@{
    ViewData["Title"] = "Appointment History";

    var prescriptions = ViewBag.Prescriptions as List<Prescription> ?? new List<Prescription>();
    var completedVisits = Model.Where(a => a.VisitRecord != null).ToList();
}

<div class="page-shell">
    <div class="page-header">
        <h2>Appointment History</h2>
        <p>Review your appointments, completed visits, diagnosis, treatment plans, and prescriptions.</p>
    </div>

    <div class="section-card">
        <div class="section-card-header">
            <h5>Appointments</h5>
        </div>

        <div class="section-card-body">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    You do not have any appointments yet.
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Reference Number</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Reason</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var appointment in Model)
                            {
                                <tr>
                                    <td>@appointment.AppointmentReferenceNumber</td>

                                    <td>@(appointment.Doctor?.User?.FullName ?? "Doctor")</td>

                                    <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        @appointment.StartTime.ToString(@"hh\:mm") - @appointment.EndTime.ToString(@"hh\:mm")
                                    </td>

                                    <td>@appointment.ReasonForVisit</td>

                                    <td>
                                        @if (appointment.Status == AppointmentStatus.Completed)
                                        {
                                            <span class="badge-soft-success">Completed</span>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Requested)
                                        {
                                            <span class="badge-soft-warning">Requested</span>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge-soft-info">Confirmed</span>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge-soft-danger">Cancelled</span>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Missed)
                                        {
                                            <span class="badge-soft-danger">Missed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft-info">@appointment.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="section-card">
        <div class="section-card-header">
            <h5>Visit Records</h5>
        </div>

        <div class="section-card-body">
            @if (!completedVisits.Any())
            {
                <div class="empty-state">
                    No completed visit records are available yet.
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var appointment in completedVisits)
                    {
                        var visit = appointment.VisitRecord;
                        var visitPrescriptions = prescriptions
                        .Where(p => p.VisitRecordId == visit!.Id)
                        .ToList();

                        <div class="col-12">
                            <div class="section-card mb-0">
                                <div class="section-card-header">
                                    <h5>
                                        Visit on @appointment.AppointmentDate.ToString("dd/MM/yyyy")
                                    </h5>
                                </div>

                                <div class="section-card-body">
                                    <p class="text-muted mb-3">
                                        Doctor: @(appointment.Doctor?.User?.FullName ?? "Doctor")
                                    </p>

                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <strong>Doctor Notes</strong>
                                            <p class="text-muted mb-0">
                                                @visit!.DoctorNotes
                                            </p>
                                        </div>

                                        <div class="col-md-4">
                                            <strong>Diagnosis</strong>
                                            <p class="text-muted mb-0">
                                                @visit.Diagnosis
                                            </p>
                                        </div>

                                        <div class="col-md-4">
                                            <strong>Treatment Plan</strong>
                                            <p class="text-muted mb-0">
                                                @visit.TreatmentPlan
                                            </p>
                                        </div>
                                    </div>

                                    <h6 class="fw-bold mb-3">Prescriptions</h6>

                                    @if (!visitPrescriptions.Any())
                                    {
                                        <div class="empty-state">
                                            No prescriptions recorded for this visit.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-wrap">
                                            <table class="table table-modern">
                                                <thead>
                                                    <tr>
                                                        <th>Medication</th>
                                                        <th>Dosage</th>
                                                        <th>Frequency</th>
                                                        <th>Duration</th>
                                                        <th>Instructions</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (var prescription in visitPrescriptions)
                                                    {
                                                        <tr>
                                                            <td>@prescription.MedicationName</td>
                                                            <td>@prescription.Dosage</td>
                                                            <td>@prescription.Frequency</td>
                                                            <td>@prescription.Duration</td>
                                                            <td>@prescription.Instructions</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Patient" asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to Dashboard
        </a>
    </div>
</div>