@model IEnumerable<ClinicSystem.Api.Models.Appointment>

@{
    ViewData["Title"] = "Appointment History";
}

<h2>Appointment History</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You do not have any appointments yet.
    </div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Reference Number</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Time</th>
                <th>Reason</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.AppointmentReferenceNumber</td>
                    <td>@(appointment.Doctor?.User?.Email ?? appointment.Doctor?.LicenseNumber ?? "N/A")</td>
                    <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</td>
                    <td>@appointment.StartTime.ToString(@"hh\:mm") - @appointment.EndTime.ToString(@"hh\:mm")</td>
                    <td>@appointment.ReasonForVisit</td>
                    <td>@appointment.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Patient" asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>