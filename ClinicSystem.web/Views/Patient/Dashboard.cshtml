@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Patient Dashboard</h2>
        <p class="text-muted">Manage your appointments, profile, and medical history.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">My Profile</h5>
                    <p class="card-text">
                        View your personal information, CPR number, and patient reference details.
                    </p>
                    <a asp-controller="Patient" asp-action="Profile" class="btn btn-primary">
                        View Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Book Appointment</h5>
                    <p class="card-text">
                        Select a specialization, doctor, date, and time to request an appointment.
                    </p>
                    <a asp-controller="Patient" asp-action="BookAppointment" class="btn btn-success">
                        Book Appointment
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Appointment History</h5>
                    <p class="card-text">
                        View your appointment history, visit records, and prescriptions.
                    </p>
                    <a asp-controller="Patient" asp-action="History" class="btn btn-secondary">
                        View History
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>