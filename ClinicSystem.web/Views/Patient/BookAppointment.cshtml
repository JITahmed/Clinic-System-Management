@using ClinicSystem.Api.Models

@{
    ViewData["Title"] = "Book Appointment";

    var doctors = ViewBag.Doctors as List<Doctor>;
    var specializations = ViewBag.Specializations as List<Specialization>;
}

<h2>Book Appointment</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<form asp-controller="Patient" asp-action="BookAppointment" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Specialization</label>
        <select id="specializationSelect" name="specializationId" class="form-control" required>
            <option value="">Select specialization</option>

            @if (specializations != null)
            {
                foreach (var specialization in specializations)
                {
                    <option value="@specialization.Id">@specialization.Name</option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Doctor</label>
        <select id="doctorSelect" name="doctorId" class="form-control" required>
            <option value="">Select doctor</option>

            @if (doctors != null)
            {
                foreach (var doctor in doctors)
                {
                    var doctorName = doctor.User?.FullName ?? doctor.User?.Email ?? doctor.LicenseNumber;

                    var specializationIds = string.Join(",",
                    doctor.DoctorSpecializations.Select(ds => ds.SpecializationId));

                    <option value="@doctor.Id" data-specializations="@specializationIds">
                        @doctorName - @doctor.LicenseNumber
                    </option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Appointment Date and Time</label>
        <input type="datetime-local"
               name="appointmentDate"
               class="form-control"
               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">Reason for Visit</label>
        <textarea name="reasonForVisit" class="form-control" rows="4" required></textarea>
    </div>

    <button type="submit" class="btn btn-success">Submit Appointment Request</button>
    <a asp-controller="Patient" asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        const specializationSelect = document.getElementById("specializationSelect");
        const doctorSelect = document.getElementById("doctorSelect");

        function filterDoctorsBySpecialization() {
            const selectedSpecializationId = specializationSelect.value;

            doctorSelect.value = "";

            Array.from(doctorSelect.options).forEach(option => {
                if (option.value === "") {
                    option.hidden = false;
                    return;
                }

                const doctorSpecializations = option.getAttribute("data-specializations") || "";
                const specializationList = doctorSpecializations.split(",");

                if (!selectedSpecializationId || specializationList.includes(selectedSpecializationId)) {
                    option.hidden = false;
                } else {
                    option.hidden = true;
                }
            });
        }

        specializationSelect.addEventListener("change", filterDoctorsBySpecialization);

        filterDoctorsBySpecialization();
    </script>
}