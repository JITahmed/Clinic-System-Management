@using ClinicSystem.Api.Models
@model IEnumerable<ClinicSystem.Api.Models.Notification>

@{
    ViewData["Title"] = "My Notifications";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div class="page-header mb-0">
            <h2>My Notifications</h2>
            <p>View your appointment notifications and mark them as read.</p>
        </div>

        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-controller="Patient" asp-action="MarkAllNotificationsAsRead" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn soft-btn btn-soft-primary">
                    Mark All as Read
                </button>
            </form>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h5 class="mb-2">No notifications</h5>
            <p class="mb-0">You do not have any notifications yet.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var notification in Model)
            {
                <div class="col-12">
                    <div class="section-card mb-0">
                        <div class="section-card-body">
                            <div class="d-flex justify-content-between align-items-start gap-3">

                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <h5 class="mb-0">@notification.Title</h5>

                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge-soft-warning">Unread</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft-success">Read</span>
                                        }
                                    </div>

                                    <p class="text-muted mb-2">
                                        @notification.Message
                                    </p>

                                    <small class="text-muted">
                                        Type: @notification.Type |
                                        Date: @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>

                                @if (!notification.IsRead)
                                {
                                    <form asp-controller="Patient"
                                          asp-action="MarkNotificationAsRead"
                                          asp-route-id="@notification.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn soft-btn btn-soft-primary btn-sm">
                                            Mark as Read
                                        </button>
                                    </form>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Patient" asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to Dashboard
        </a>
    </div>
</div>