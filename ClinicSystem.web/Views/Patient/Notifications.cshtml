@using ClinicSystem.Api.Models
@model IEnumerable<Notification>

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="page-shell">
    <div class="page-header d-flex justify-content-between align-items-start">
        <div>
            <h2>Notifications</h2>
            <p>View your clinic notifications and mark them as read.</p>
        </div>

        <a asp-controller="Patient" asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (unreadCount > 0)
    {
        <form asp-controller="Patient" asp-action="MarkAllNotificationsAsRead" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn soft-btn btn-soft-primary">
                Mark All as Read
            </button>
        </form>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bell"></i>
            <h5>No notifications yet</h5>
            <p>You currently do not have any clinic notifications.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var notification in Model)
            {
                <div class="col-12">
                    <div class="section-card">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h5 class="mb-1">@notification.Title</h5>
                                <p class="mb-2 text-muted">@notification.Message</p>
                                <small class="text-muted">
                                    @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy - hh:mm tt")
                                </small>
                            </div>

                            <div class="text-end">
                                @if (notification.IsRead)
                                {
                                    <span class="badge-soft-success">Read</span>
                                }
                                else
                                {
                                    <span class="badge-soft-warning">Unread</span>

                                    <form asp-controller="Patient" asp-action="MarkNotificationAsRead" method="post" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@notification.Id" />
                                        <button type="submit" class="btn btn-sm soft-btn btn-soft-primary">
                                            Mark as Read
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>