@model ClinicSystem.Api.Models.Patient

@{
    ViewData["Title"] = "Patient Profile";
}

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div class="page-header mb-0">
            <h2>Patient Profile</h2>
            <p>View your registered personal information and emergency contact details.</p>
        </div>

        <a asp-controller="Patient" asp-action="EditProfile" class="btn soft-btn btn-soft-primary">
            Edit Profile
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="section-card">
                <div class="section-card-header">
                    <h5>Personal Information</h5>
                </div>

                <div class="section-card-body">
                    <table class="table table-bordered info-table">
                        <tr>
                            <th>Full Name</th>
                            <td>@(Model.User?.FullName ?? "N/A")</td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td>@(Model.User?.Email ?? "N/A")</td>
                        </tr>

                        <tr>
                            <th>Phone Number</th>
                            <td>@(Model.User?.PhoneNumber ?? "N/A")</td>
                        </tr>

                        <tr>
                            <th>CPR Number</th>
                            <td>@Model.CPRNumber</td>
                        </tr>

                        <tr>
                            <th>Patient Reference Number</th>
                            <td>@Model.PatientReferenceNumber</td>
                        </tr>

                        <tr>
                            <th>Date of Birth</th>
                            <td>@Model.DateOfBirth.ToString("dd/MM/yyyy")</td>
                        </tr>

                        <tr>
                            <th>Gender</th>
                            <td>@Model.Gender</td>
                        </tr>

                        <tr>
                            <th>Blood Type</th>
                            <td>@Model.BloodType</td>
                        </tr>

                        <tr>
                            <th>Allergies</th>
                            <td>@Model.Allergies</td>
                        </tr>

                        <tr>
                            <th>Address</th>
                            <td>@Model.Address</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="section-card">
                <div class="section-card-header">
                    <h5>Emergency Contact</h5>
                </div>

                <div class="section-card-body">
                    <table class="table table-bordered info-table">
                        <tr>
                            <th>Contact Name</th>
                            <td>@Model.EmergencyContactName</td>
                        </tr>

                        <tr>
                            <th>Contact Phone</th>
                            <td>@Model.EmergencyContactPhone</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="section-card">
                <div class="section-card-header">
                    <h5>Profile Note</h5>
                </div>

                <div class="section-card-body">
                    <p class="text-muted mb-0">
                        You can update your phone number, CPR number, allergies, address, and emergency contact details using the Edit Profile button above.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-4">
        <a asp-controller="Patient" asp-action="Dashboard" class="btn soft-btn btn-soft-secondary btn-back">
            <span>←</span> Back to Dashboard
        </a>
    </div>
</div>