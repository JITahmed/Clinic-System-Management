@model ClinicSystem.Api.Models.Patient

@{
    ViewData["Title"] = "Patient Profile";
}

<h2>Patient Profile</h2>

<p>This page shows the patient's personal information.</p>

<table class="table table-bordered">
    <tr>
        <th>Email</th>
        <td>@(Model.User?.Email ?? "N/A")</td>
    </tr>
    <tr>
        <th>Phone Number</th>
        <td>@(Model.User?.PhoneNumber ?? "N/A")</td>
    </tr>
    <tr>
        <th>CPR Number</th>
        <td>@Model.CPRNumber</td>
    </tr>
    <tr>
        <th>Patient Reference Number</th>
        <td>@Model.PatientReferenceNumber</td>
    </tr>
</table>

<a asp-controller="Patient" asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>